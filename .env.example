# Plantilla de variables de entorno. Copiala a `.env` y rellena los valores reales.
# `.env` esta git-ignorado y NUNCA se versiona. Este archivo no contiene credenciales.
#
# Prisma necesita LAS DOS (docs/architecture.md > Variables de entorno de la base):
# sin `DIRECT_URL`, Prisma Migrate falla a traves del pooler en transaction mode con
# errores que no apuntan a la causa.

# Conexion que usa la app en runtime. En Supabase, el pooler (pgbouncer, puerto 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE

# Conexion directa (puerto 5432). La que usa Prisma Migrate.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secreto con el que se firma la cookie de sesion (HMAC-SHA256). Minimo 32 caracteres,
# aleatorio y DISTINTO en cada entorno. Si falta o es mas corto, el login falla sin emitir
# cookie (fail closed): no se degrada a una sesion sin firmar.
SESSION_SECRET=

# Seed del usuario inicial (QC-6). Solo hacen falta en un entorno NUEVO: si ya existe un
# usuario vivo con rol Administrador, el seed ni siquiera las lee. Ninguna credencial se
# escribe aqui ni en ningun otro archivo versionado.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=


# ---------------------------------------------------------------------------
# Servidores MCP (`.mcp.json`)
#
# OJO: estas tres NO se leen de este archivo. `.mcp.json` las interpola desde el
# ENTORNO DEL PROCESO, asi que ponerlas en `.env` no basta: hay que exportarlas
# en la terminal (o como variable de usuario en Windows) y reiniciar Claude Code.
# Se documentan aqui para que no se pierdan, no para que se carguen desde aqui.
# ---------------------------------------------------------------------------

# Jira / Rovo MCP. Es `email:token` en base64, NO el token pelado.
# Token: id.atlassian.com/manage-profile/security/api-tokens (scopes Jira read/write).
# Habilitarlo antes en Atlassian Administration > Rovo > Rovo MCP server > Authentication.
# Contrato completo y por que Basic y no OAuth: docs/jira.md.
#
#   bash:        export ATLASSIAN_MCP_AUTH=$(printf '%s' "tu.email@dominio.com:TU_TOKEN" | base64 -w0)
#   powershell:  [Environment]::SetEnvironmentVariable("ATLASSIAN_MCP_AUTH", [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("tu.email@dominio.com:TU_TOKEN")), "User")
ATLASSIAN_MCP_AUTH=

# Context7 MCP (documentacion de librerias). Se obtiene en context7.com.
CONTEXT7_API_KEY=

# Supabase MCP. Es el project ref del proyecto, no una credencial:
# Supabase > Project Settings > General > Reference ID.
SUPABASE_PROJECT_REF=


# ---------------------------------------------------------------------------
# Storage de recetas (QC-25). Bucket PUBLICO para la imagen de cada receta.
# Se leen en el momento de la invocacion, nunca al importar el modulo
# (lib/modules/recetas/adapters/driven/config/storage-config-env.ts); si falta alguna,
# el adaptador falla nombrandola, sin filtrar ningun valor.
# ---------------------------------------------------------------------------

# Direccion del proyecto de Storage, p. ej. https://<project-ref>.supabase.co. NO
# reutiliza SUPABASE_PROJECT_REF: esa es solo para los servidores MCP y no se lee de
# .env (design.md > 9.4 de QC-25).
SUPABASE_STORAGE_URL=

# Nombre del bucket PUBLICO donde viven las imagenes de receta (recetas/<uuid>.<ext>).
SUPABASE_STORAGE_BUCKET=

# Credencial con permiso de escritura en ese bucket. SECRETO: nunca al repo.
SUPABASE_STORAGE_KEY=


# ---------------------------------------------------------------------------
# Correo del enlace para establecer la contrasena (QC-79). Se leen en el momento de la
# invocacion, nunca al importar el modulo
# (lib/modules/identity/adapters/driven/config/mail-config-env.ts); si falta alguna, el
# adaptador falla nombrandola, sin filtrar ningun valor.
# ---------------------------------------------------------------------------

# Credencial del proveedor de correo (Resend). SECRETO: nunca al repo.
RESEND_API_KEY=

# Direccion remitente del correo. SU VALOR LO DECIDE EL HUMANO: el proveedor exige un
# dominio verificado por DNS y en el repositorio no hay ningun dato del dominio de correo
# de la empresa (pregunta abierta 1 de specs/QC-79-alta-sin-contrasena-y-enlace).
MAIL_FROM_ADDRESS=

# Base con la que se construye la URL del enlace, p. ej. https://app.dominio.com (sin
# barra final). Es lo unico que se le antepone al secreto del enlace.
APP_BASE_URL=

# Transporte de correo: `resend` (el real, y el valor por defecto si esta vacia) o `outbox`
# (escribe el mensaje a un archivo, solo para el E2E). Cualquier otro valor falla.
MAIL_TRANSPORT=

# Directorio donde el transporte `outbox` escribe cada mensaje como JSON. Solo la lee ese
# transporte, y solo se cablea si MAIL_TRANSPORT=outbox se puso a mano; si falta, el
# transporte LANZA nombrandola, en vez de tragarse el mensaje en silencio. El adaptador se
# niega ademas a arrancar con NODE_ENV=production.
MAIL_OUTBOX_DIR=

# --- Modelos para el arnes en opencode -------------------------------------------------
#
# Solo las lee opencode (via `opencode.json`). Claude Code no usa ninguna de estas: si solo
# trabajas con Claude Code, dejalas vacias y el arnes funciona igual. `./init.sh` no falla
# por que falten; `scripts/check-modelos.mjs` avisa y sigue.

# Clave de build.nvidia.com. UNA sola key cubre los CINCO modelos de NVIDIA que usa el arnes
# -kimi-k3, deepseek-v4-flash-0731, nemotron-3-ultra, nemotron-3-super, nemotron-3.5-lightning-,
# primarios y de respaldo por igual: los sirve el mismo endpoint. Anadir un modelo de NVIDIA a
# una cadena no anade una credencial. Se saca creando cuenta en
# https://build.nvidia.com (NVIDIA Developer Program, sin tarjeta) y empieza por `nvapi-`.
#
# El acceso es de tipo *trial* y sin limite de duracion, pero SI con techo de ritmo: ~40
# requests/minuto para la cuenta entera, ampliable a 200 pidiendolo en el foro. El limite
# exacto se ve arriba a la derecha en build.nvidia.com. Ya no hay sistema de creditos.
# Vale aqui o como variable de entorno; el entorno manda si estan las dos. OJO: opencode NO
# carga este archivo por su cuenta -se comprobo: el {env:...} se resuelve a cadena VACIA y la
# peticion sale con la credencial en blanco, sin avisar-. Por eso se lanza con el wrapper
# scripts/opencode.ps1 (o .sh), que carga .env al entorno antes de arrancar.
NVIDIA_API_KEY=


# Los modelos gratuitos de opencode Zen -el ultimo eslabon de cada cadena de respaldo- NO
# llevan variable de entorno: se autentican con /connect dentro de la TUI de opencode, que
# guarda la credencial en su propio almacen. Detalle en docs/opencode.md.
