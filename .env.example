# Plantilla de variables de entorno. Copiala a `.env` y rellena los valores reales.
# `.env` esta git-ignorado y NUNCA se versiona. Este archivo no contiene credenciales.
#
# Prisma necesita LAS DOS (docs/architecture.md > Variables de entorno de la base):
# sin `DIRECT_URL`, Prisma Migrate falla a traves del pooler en transaction mode con
# errores que no apuntan a la causa.

# Conexion que usa la app en runtime. En Supabase, el pooler (pgbouncer, puerto 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE

# Conexion directa (puerto 5432). La que usa Prisma Migrate.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secreto con el que se firma la cookie de sesion (HMAC-SHA256). Minimo 32 caracteres,
# aleatorio y DISTINTO en cada entorno. Si falta o es mas corto, el login falla sin emitir
# cookie (fail closed): no se degrada a una sesion sin firmar.
SESSION_SECRET=

# Seed del usuario inicial (QC-6). Solo hacen falta en un entorno NUEVO: si ya existe un
# usuario vivo con rol Administrador, el seed ni siquiera las lee. Ninguna credencial se
# escribe aqui ni en ningun otro archivo versionado.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=


# ---------------------------------------------------------------------------
# Servidores MCP (`.mcp.json`)
#
# OJO: estas tres NO se leen de este archivo. `.mcp.json` las interpola desde el
# ENTORNO DEL PROCESO, asi que ponerlas en `.env` no basta: hay que exportarlas
# en la terminal (o como variable de usuario en Windows) y reiniciar Claude Code.
# Se documentan aqui para que no se pierdan, no para que se carguen desde aqui.
# ---------------------------------------------------------------------------

# Jira / Rovo MCP. Es `email:token` en base64, NO el token pelado.
# Token: id.atlassian.com/manage-profile/security/api-tokens (scopes Jira read/write).
# Habilitarlo antes en Atlassian Administration > Rovo > Rovo MCP server > Authentication.
# Contrato completo y por que Basic y no OAuth: docs/jira.md.
#
#   bash:        export ATLASSIAN_MCP_AUTH=$(printf '%s' "tu.email@dominio.com:TU_TOKEN" | base64 -w0)
#   powershell:  [Environment]::SetEnvironmentVariable("ATLASSIAN_MCP_AUTH", [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("tu.email@dominio.com:TU_TOKEN")), "User")
ATLASSIAN_MCP_AUTH=

# Context7 MCP (documentacion de librerias). Se obtiene en context7.com.
CONTEXT7_API_KEY=

# Supabase MCP. Es el project ref del proyecto, no una credencial:
# Supabase > Project Settings > General > Reference ID.
SUPABASE_PROJECT_REF=


# ---------------------------------------------------------------------------
# Storage de recetas (QC-25). Bucket PUBLICO para la imagen de cada receta.
# Se leen en el momento de la invocacion, nunca al importar el modulo
# (lib/modules/recetas/adapters/driven/config/storage-config-env.ts); si falta alguna,
# el adaptador falla nombrandola, sin filtrar ningun valor.
# ---------------------------------------------------------------------------

# Direccion del proyecto de Storage, p. ej. https://<project-ref>.supabase.co. NO
# reutiliza SUPABASE_PROJECT_REF: esa es solo para los servidores MCP y no se lee de
# .env (design.md > 9.4 de QC-25).
SUPABASE_STORAGE_URL=

# Nombre del bucket PUBLICO donde viven las imagenes de receta (recetas/<uuid>.<ext>).
SUPABASE_STORAGE_BUCKET=

# Credencial con permiso de escritura en ese bucket. SECRETO: nunca al repo.
SUPABASE_STORAGE_KEY=


# ---------------------------------------------------------------------------
# Correo del enlace para establecer la contrasena (QC-79). Se leen en el momento de la
# invocacion, nunca al importar el modulo
# (lib/modules/identity/adapters/driven/config/mail-config-env.ts); si falta alguna, el
# adaptador falla nombrandola, sin filtrar ningun valor.
# ---------------------------------------------------------------------------

# Credencial del proveedor de correo (Resend). SECRETO: nunca al repo.
RESEND_API_KEY=

# Direccion remitente del correo. SU VALOR LO DECIDE EL HUMANO: el proveedor exige un
# dominio verificado por DNS y en el repositorio no hay ningun dato del dominio de correo
# de la empresa (pregunta abierta 1 de specs/QC-79-alta-sin-contrasena-y-enlace).
MAIL_FROM_ADDRESS=

# Base con la que se construye la URL del enlace, p. ej. https://app.dominio.com (sin
# barra final). Es lo unico que se le antepone al secreto del enlace.
APP_BASE_URL=

# Transporte de correo: `resend` (el real, y el valor por defecto si esta vacia) o `outbox`
# (escribe el mensaje a un archivo, solo para el E2E). Cualquier otro valor falla.
MAIL_TRANSPORT=

# Directorio donde el transporte `outbox` escribe cada mensaje como JSON. Solo la lee ese
# transporte, y solo se cablea si MAIL_TRANSPORT=outbox se puso a mano; si falta, el
# transporte LANZA nombrandola, en vez de tragarse el mensaje en silencio. El adaptador se
# niega ademas a arrancar con NODE_ENV=production.
MAIL_OUTBOX_DIR=


# ---------------------------------------------------------------------------
# Storage de documentos. Bucket PRIVADO, solo para los PDF que se suben con enlace
# firmado. Se lee en el momento de la invocacion, nunca al importar el modulo
# (lib/modules/documentos/adapters/driven/config/document-storage-config-env.ts); si falta
# alguna, el adaptador falla nombrandola, sin filtrar ningun valor.
#
# Aqui solo se declara UNA variable nueva: la direccion del proyecto
# (SUPABASE_STORAGE_URL) y la credencial (SUPABASE_STORAGE_KEY) se REUTILIZAN de las de
# arriba, porque son el proyecto y la credencial, no el bucket, y duplicarlas serian dos
# verdades para el mismo dato.
# ---------------------------------------------------------------------------

# Nombre del bucket PRIVADO donde viven los PDF (<empresa>/<uuid>.pdf). Distinto del
# bucket PUBLICO de las imagenes de receta, que no se toca. Sus limites de tamano maximo
# por archivo y de tipo permitido se configuran EN EL BUCKET, no en el codigo.
SUPABASE_DOCUMENTS_BUCKET=


# ---------------------------------------------------------------------------
# Lectura de PDF con IA (QC-108). Se leen en el momento de la invocacion, nunca al
# importar el modulo (lib/modules/documentos/adapters/driven/config/ai-config-env.ts);
# si falta alguna, la lectura falla nombrandola, sin filtrar ningun valor.
# ---------------------------------------------------------------------------

# Credencial del proveedor de IA. SECRETO: nunca al repo. UNA SOLA por despliegue: no
# hay clave por empresa.
GEMINI_API_KEY=

# Nombre del modelo. OBLIGATORIA: si falta, la lectura falla con un error explicito y NO
# cae a ningun modelo por defecto. "Gemini Flash" es una familia, no una version, y un id
# escrito a mano deja de existir sin avisar.
GEMINI_MODEL=


# ---------------------------------------------------------------------------
# Procesamiento de PDF en cola (QC-111). Se leen en el momento de la invocacion, nunca al
# importar el modulo
# (lib/modules/documentos/adapters/driven/config/processing-config-env.ts); si falta
# alguna de las cuatro de QStash, el adaptador falla nombrandolas todas juntas, sin
# filtrar ningun valor.
# ---------------------------------------------------------------------------

# Credencial de publicacion de QStash. SECRETO: nunca al repo.
QSTASH_TOKEN=

# Clave con la que se verifica la firma del webhook. SECRETO: nunca al repo.
QSTASH_CURRENT_SIGNING_KEY=

# La siguiente clave de firma, para la rotacion sin caida. SECRETO: nunca al repo.
QSTASH_NEXT_SIGNING_KEY=

# URL publica del Route Handler que QStash llama, p. ej.
# https://app.dominio.com/api/documentos/trabajos.
QSTASH_TARGET_URL=

# Cuanto puede llevar una fila en cola o procesando antes de caducar, en segundos.
# OPCIONAL: vacia aplica el valor por defecto (900).
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=

# Tope de reintentos que la cola aplica a un mensaje antes de dejar de entregarlo.
# OPCIONAL: vacia aplica el valor por defecto (3).
DOCUMENT_PROCESSING_MAX_RETRIES=


# ---------------------------------------------------------------------------
# Texto del prompt por estrategia (QC-129). Se leen en el momento de la invocacion, nunca al
# importar el modulo (lib/modules/documentos/adapters/driven/config/strategy-prompt-env.ts);
# si falta alguna, el procesamiento falla nombrandola, sin llamar al proveedor de IA. Sin
# valor de ejemplo: el texto vive solo en el entorno de despliegue, nunca en el repositorio.
# ---------------------------------------------------------------------------

# Prompt de la estrategia `catalogo`. No es un secreto, pero tampoco es publica: sin prefijo
# NEXT_PUBLIC_ porque no tiene por que viajar al navegador. Se escribe en Vercel, no aqui.
CATALOG_PROMPT=

# Prompt de la estrategia `formula`. Variable propia, no la anterior: cambiar una no afecta a
# la otra.
FORMULA_PROMPT=


# ---------------------------------------------------------------------------
# Dobles de prueba del modulo `documentos`. Se lee en el momento de la invocacion, nunca
# al importar el modulo
# (lib/modules/documentos/adapters/driven/config/e2e-doubles-env.ts).
#
# VACIA, y asi se queda: su ausencia significa los adaptadores REALES. Puesta con
# cualquier valor, el punto de composicion cablea el almacenamiento en memoria, la cola en
# linea y la IA de guion, que es lo que permite que el recorrido de extremo a extremo corra
# sin red, sin bucket, sin URL publica y sin cuenta de IA. El UNICO archivo versionado que
# la activa es playwright.config.ts, y lo vigila
# tests/guards/guard-dobles-e2e.test.ts.
# ---------------------------------------------------------------------------

DOCUMENTS_E2E_DOUBLES=
