# Plantilla de variables de entorno. Copiala a `.env` y rellena los valores reales.
# `.env` esta git-ignorado y NUNCA se versiona. Este archivo no contiene credenciales.
#
# Prisma necesita LAS DOS (docs/architecture.md > Variables de entorno de la base):
# sin `DIRECT_URL`, Prisma Migrate falla a traves del pooler en transaction mode con
# errores que no apuntan a la causa.

# Conexion que usa la app en runtime. En Supabase, el pooler (pgbouncer, puerto 6543).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE

# Conexion directa (puerto 5432). La que usa Prisma Migrate.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE


# ---------------------------------------------------------------------------
# Servidores MCP (`.mcp.json`)
#
# OJO: estas tres NO se leen de este archivo. `.mcp.json` las interpola desde el
# ENTORNO DEL PROCESO, asi que ponerlas en `.env` no basta: hay que exportarlas
# en la terminal (o como variable de usuario en Windows) y reiniciar Claude Code.
# Se documentan aqui para que no se pierdan, no para que se carguen desde aqui.
# ---------------------------------------------------------------------------

# Jira / Rovo MCP. Es `email:token` en base64, NO el token pelado.
# Token: id.atlassian.com/manage-profile/security/api-tokens (scopes Jira read/write).
# Habilitarlo antes en Atlassian Administration > Rovo > Rovo MCP server > Authentication.
# Contrato completo y por que Basic y no OAuth: docs/jira.md.
#
#   bash:        export ATLASSIAN_MCP_AUTH=$(printf '%s' "tu.email@dominio.com:TU_TOKEN" | base64 -w0)
#   powershell:  [Environment]::SetEnvironmentVariable("ATLASSIAN_MCP_AUTH", [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("tu.email@dominio.com:TU_TOKEN")), "User")
ATLASSIAN_MCP_AUTH=

# Context7 MCP (documentacion de librerias). Se obtiene en context7.com.
CONTEXT7_API_KEY=

# Supabase MCP. Es el project ref del proyecto, no una credencial:
# Supabase > Project Settings > General > Reference ID.
SUPABASE_PROJECT_REF=
