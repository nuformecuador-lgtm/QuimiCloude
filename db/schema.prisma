// Esquema de QuimiCloude. Vive en `db/schema.prisma`, no en `prisma/` (la ruta se
// declara en `package.json > prisma.schema`). Ver `docs/architecture.md > Migraciones
// up/down`.
//
// Convencion: identificadores de base en INGLES y `snake_case` (via `@@map`/`@map`);
// los campos del cliente Prisma en `camelCase`. Todo texto es `text`: no se usan
// `varchar(n)` arbitrarios.

datasource db {
  provider  = "postgresql"
  // Runtime: pooler transaccional (:6543). Ver `lib/db/prisma-client.ts`.
  url       = env("DATABASE_URL")
  // Migraciones: conexion en modo sesion (:5432). `prisma.config.ts` la iguala a
  // DATABASE_URL cuando no esta definida (local, sin pooler).
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Catalogo del conjunto cerrado de tipos de documento de identidad (design.md > 3).
/// No lleva `deletedAt` a proposito: un tipo no se borra, se desactiva con `isActive`.
/// @module identity
model DocumentType {
  code      String   @id
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("document_types")
}

/// Catalogo de roles. NO lleva `deletedAt` deliberadamente (design.md > 2.2): el
/// borrado logico es un UPDATE y una FK no puede bloquear un UPDATE, asi que anadir
/// la columna neutralizaria en silencio la unica garantia real de R17.
/// @module identity
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// Catalogo cerrado de permisos (QC-74, R1, R2). Como `roles`, NO lleva `deletedAt`: un
/// permiso no se da de baja, se retira con una migracion.
///
/// `code` es la clave primaria DE TEXTO (`'inventario.consultar'`), no un uuid: mismo patron
/// que `document_types.code`, y hace legible `role_permissions` sin un JOIN mas. `module` y
/// `action` van desnormalizados en columnas propias porque la guardia y las consultas por
/// modulo preguntan por ellas, y partir la cadena en SQL en cada consulta es peor.
///
/// El catalogo y sus asignaciones NO se administran por la aplicacion (R5): los siembra
/// `seedInitialAccess` y se cambian por migracion.
/// @module identity
model Permission {
  code        String   @id
  module      String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

/// Permisos asignados a un rol (QC-74, R7, R8, R9). SIN columna de empresa (R6): el permiso
/// cuelga del rol y de nada mas (`docs/architecture.md > Dominio`).
///
/// Clave primaria compuesta: una asignacion no puede duplicarse y el indice de la PK cubre la
/// consulta caliente (`WHERE role_id = ?`), que es la que hace la lectura de sesion.
/// `@@index([permissionCode])` sirve el sentido inverso. `onDelete: Restrict` en las dos FKs,
/// igual que `users.role_id`: no se borran roles ni permisos arrastrando asignaciones en
/// silencio. `users` NO cambia: el rol sigue siendo `users.role_id` (QC-47 R13/R14).
/// @module identity
model RolePermission {
  roleId         String   @map("role_id") @db.Uuid
  permissionCode String   @map("permission_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

/// Estado de la cuenta de un usuario (QC-65, decisiones cerradas 1 y 2). Conjunto CERRADO en
/// el propio esquema: anadir un quinto valor es una migracion (`ALTER TYPE ... ADD VALUE`), y
/// el humano lo asumio a conciencia — este conjunto NO tiene que crecer sin desplegar.
/// Se aparta del precedente de `DocumentType` (QC-4) y del catalogo `Unit` (QC-32), que son
/// TABLAS porque debian crecer con un INSERT; sigue el de `OrderStatus` (QC-33).
///
/// Los valores van en INGLES y en minuscula, literalmente como los fijo la decision cerrada 1.
/// Se apartan de `OrderStatus`/`OrderPriority`, que son MAYUSCULAS en espanol, a proposito:
/// la decision escribe los cuatro nombres, y tener una segunda grafia («ACTIVE» en el codigo,
/// «active» en la ficha) es exactamente la clase de traduccion silenciosa que se desincroniza.
///
/// QUE SIGNIFICA CADA UNO (decision cerrada 2):
///   active   — la cuenta funciona.
///   pending  — creada, aun no habilitada para entrar.
///   inactive — apagada a proposito por un administrador. REVERSIBLE.
///   blocked  — bloqueada por seguridad. Es LA MISMA COSA que el bloqueo por intentos
///              fallidos de QC-19, pero QC-65 no los unifica: eso es QC-78.
/// NADIE lee todavia este valor para decidir nada (R19).
///
/// El orden de declaracion NO significa nada aqui (a diferencia de `OrderPriority`), pero es
/// el mismo de la decision cerrada 1 y el de `USER_ACCOUNT_STATUSES`
/// (`lib/modules/identity/domain/account-status.ts`), que es la UNICA definicion del conjunto:
/// asi el test puede compararlos con una igualdad ORDENADA y no con un conjunto.
enum UserAccountStatus {
  active
  pending
  inactive
  blocked
}

/// Usuario del ERP. Borrado logico: `deletedAt` NULL = usuario vivo.
///
/// OJO 0 — EL ROL DE UNA PERSONA VIVE EN ESTA TABLA, en `roleId`, y QC-47 NO lo mueve
/// (R13, R14): mismo nombre, mismo tipo, `NOT NULL`, misma FK `users_role_id_fkey`
/// (`ON DELETE RESTRICT ON UPDATE CASCADE`) y mismo indice `users_role_id_idx` que dejo
/// QC-4. Un usuario tiene UN solo rol y pertenece a UNA sola empresa; no hay ninguna tabla
/// intermedia entre usuario y empresa, y no debe aparecer (R12). Quien saque el rol de aqui
/// parte en dos la verdad sobre el rol y rompe el login, la sesion y el seed, que lo leen
/// todos de esta columna sin ninguna consulta adicional.
///
/// OJO — las tres unicidades de esta tabla (correo, nombre de usuario y la pareja
/// tipo+numero de documento) NO estan aqui como `@unique`/`@@unique` y eso es
/// deliberado: son indices unicos FUNCIONALES (`lower(...)`) y PARCIALES
/// (`WHERE deleted_at IS NULL`), y Prisma no modela ninguna de las dos cosas.
/// Viven escritos a mano en `db/migrations/<ts>_users_and_roles/migration.sql`
/// (`users_email_unique`, `users_username_unique`, `users_document_unique`) y ese es
/// el unico sitio donde existen. El porque esta en `design.md > 4` y `> 5`; el test
/// `tests/unit/schema/identity-migration.test.ts` los vigila. Si alguien anade aqui
/// un `@unique`, la unicidad deja de respetar mayusculas/minusculas y el borrado
/// logico quema el correo y el documento para siempre.
///
/// OJO 2 — desde QC-47 esos tres indices llevan `company_id` COMO PRIMERA COLUMNA: el correo,
/// el nombre de usuario y la pareja tipo+numero de documento son unicos DENTRO de la empresa,
/// no en todo el sistema (R16, R17, R18). Dos empresas pueden tener cada una su `admin`.
/// `users_company_id_idx` NO es redundante con ellos: los tres son PARCIALES
/// (`WHERE deleted_at IS NULL`) y la verificacion del `RESTRICT` al borrar una empresa tiene
/// que mirar tambien a los usuarios dados de baja.
/// @module identity
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstNames       String    @map("first_names")
  lastNames        String    @map("last_names")
  birthDate        DateTime  @map("birth_date") @db.Date
  email            String
  phone            String
  documentTypeCode String    @map("document_type_code")
  documentNumber   String    @map("document_number")
  username         String
  passwordHash     String    @map("password_hash")
  roleId           String    @map("role_id") @db.Uuid
  /// La UNICA empresa a la que pertenece esta persona (QC-47 R9). OBLIGATORIA en la base:
  /// `NOT NULL` + `users_company_id_fkey` `ON DELETE RESTRICT ON UPDATE CASCADE` (R10, R11).
  /// Lleva `@relation` de Prisma —y no un escalar suelto como `products.unit_id`— porque
  /// `User` y `Company` son los dos de `identity` y no hay frontera de modulo que proteger,
  /// asi que la FK la genera Prisma en vez de quedar como drift manual.
  companyId        String    @map("company_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockLevel           Int       @default(0) @map("lock_level")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  /// TRUE = esta persona tiene que cambiar su contrasena la primera vez que entre.
  /// El nombre evita el segmento `password` a proposito (design.md > 2). Quien la LEE y
  /// bloquea el acceso es QC-7; esta ficha solo la escribe.
  mustChangeCredential Boolean @default(false) @map("must_change_credential")

  /// QC-65 (R1, R5). Estado de la cuenta. NOT NULL con `@default(pending)`: una cuenta nueva
  /// nace PENDIENTE (decision cerrada 3), y la migracion deja en `active` a las filas que ya
  /// existian (R6). SIN indice a proposito: hoy no hay ninguna consulta que filtre por el
  /// (R19); el que haga falta lo anade quien estrene la consulta (QC-67).
  accountStatus UserAccountStatus @default(pending) @map("account_status")

  /// QC-65 (R8, R9). CUANDO cambio el estado por ultima vez. NOT NULL con `@default(now())`:
  /// en una fila recien creada vale lo mismo que `createdAt`, y eso es correcto — el estado
  /// cambio, de nada a `pending`, en ese instante.
  accountStatusChangedAt DateTime @default(now()) @map("account_status_changed_at") @db.Timestamptz(6)

  /// QC-65 (R10, R11, R12). QUIEN lo cambio. OPCIONAL: NULL significa «lo cambio el sistema,
  /// no una persona» —el backfill de la migracion, el seed, y manana el bloqueo automatico de
  /// QC-19 cuando QC-78 lo unifique—, nunca «se perdio el dato».
  ///
  /// OJO — es un ESCALAR uuid SIN `@relation`, y es deliberado (`design.md > 1.3`). La FK real
  /// (`users_account_status_changed_by_fkey`, ON DELETE RESTRICT ON UPDATE CASCADE) vive
  /// escrita A MANO en la migracion. Es DRIFT para Prisma: toda migracion futura de `users`
  /// hay que revisarla a mano para que no emita su `DROP CONSTRAINT`, igual que ya pasa con
  /// los tres indices unicos funcionales de QC-4.
  accountStatusChangedBy String? @map("account_status_changed_by") @db.Uuid

  documentType DocumentType @relation(fields: [documentTypeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId], map: "users_id_company_id_key")
  @@index([roleId], map: "users_role_id_idx")
  @@index([companyId], map: "users_company_id_idx")
  @@index([documentTypeCode], map: "users_document_type_code_idx")
  /// QC-65 (R11, R12). El lado hijo de `users_account_status_changed_by_fkey`, que Postgres no
  /// indexa solo: por ahi pasa la verificacion del RESTRICT en cada intento de borrado fisico.
  @@index([accountStatusChangedBy], map: "users_account_status_changed_by_idx")
  @@map("users")
}

/// Empresa del ERP (QC-47). Borrado LOGICO: `deletedAt` NULL = empresa viva (R5). Nace con
/// la tabla y NADIE la escribe en esta ficha: no hay alta, edicion ni baja de empresas
/// (R28), solo el modelo y la empresa inicial que crea el seed.
///
/// LA EMPRESA DE UNA PERSONA ES UNA COLUMNA DEL USUARIO, no una tabla intermedia:
/// `users.company_id`, OBLIGATORIA (R9), con FK `users_company_id_fkey`
/// `ON DELETE RESTRICT` (R10, R11). Un usuario
/// pertenece a UNA sola empresa y no hay ninguna forma de asociarlo a una segunda (R12); el
/// `users User[]` de abajo es solo el lado inverso de esa columna. Si algun dia hiciera falta
/// que una persona trabaje en dos empresas, es ficha propia, migracion de datos y una decision
/// sobre como identifica el login a quien entra (QC-48), no una relacion que se anada aqui.
///
/// Vive en `identity` y no en un modulo propio (design.md > 1): la empresa se referencia desde
/// una columna del propio usuario, no desde una tabla intermedia, y partir esas dos filas en
/// dos modulos costaria una FK escrita a mano y la transaccion unica del seed. Si algun dia
/// nace un CRUD de empresas, la mudanza es barata MIENTRAS nadie lea `companies` desde fuera
/// — y eso ya lo prohibe R27.
///
/// OJO — la unicidad del nombre NO esta aqui como `@@unique` y es deliberado, igual que en
/// `Recipe` y `Supplier`: es un indice unico FUNCIONAL (`lower(...)`) y PARCIAL
/// (`WHERE deleted_at IS NULL`) sobre `name_normalized`, y Prisma no modela ninguna de las
/// dos cosas. Vive escrito a mano en `migration.sql` (`companies_name_unique`) y ese es el
/// unico sitio donde existe. Si alguien "arregla" el esquema anadiendo el `@@unique`, la
/// unicidad pasa a ser TOTAL sin que nadie se entere y una empresa dada de baja quema su
/// nombre para siempre.
///
/// Es la UNICA garantia de R4: no hay `SELECT` previo por igualdad —seria una carrera, entre
/// el `SELECT` y el `INSERT` cabe otra transaccion— y el choque se traduce del SQLSTATE
/// `23505`, mismo criterio que `Presentation`, `Unit` y `Supplier`.
///
/// `nameNormalized` la calcula `normalizeCompanyName` (dominio de `identity`, funcion pura) y
/// se persiste junto a `name` en toda escritura (R3).
/// @module identity
model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  users      User[]
  workGroups WorkGroup[]

  @@map("companies")
}

/// Grupo de trabajo (QC-83): un conjunto de personas con nombre —«Turno noche», «Planta 2»—
/// dentro de UNA empresa. Vive en `identity` porque un grupo es un conjunto de personas y las
/// personas ya viven aqui (Alcance de la ficha, design.md > 9.5).
///
/// Borrado LOGICO: `deletedAt` NULL = grupo vivo (R7). Nace con la tabla y NADIE la escribe en
/// esta ficha: no hay alta, edicion, baja ni lectura de grupos (R27) — eso es QC-84.
///
/// OJO — la unicidad del nombre NO esta aqui como `@@unique` y es deliberado (R4, R5, R6),
/// igual que en `Company`, `Recipe`, `Supplier` y `Unit`: `work_groups_name_unique` es un
/// indice COMPUESTO con `company_id`, FUNCIONAL (`lower(...)`) y PARCIAL
/// (`WHERE deleted_at IS NULL`), y Prisma no modela ninguna de las tres cosas. Vive escrito a
/// mano en el `migration.sql` de esta ficha y ese es el unico sitio donde existe. Si alguien
/// "arregla" el esquema anadiendo `@@unique([companyId, nameNormalized])`, la unicidad pasa a
/// ser TOTAL sin que nadie se entere —R6 muerto, y sin ningun error— y un grupo dado de baja
/// quema su nombre para siempre (riesgo 3 de `design.md > 8`).
///
/// Es la UNICA garantia de R4: no hay `SELECT` previo por igualdad —seria una carrera— y el
/// choque se traduce del SQLSTATE `23505`.
///
/// `nameNormalized` la calcula `normalizeWorkGroupName` (dominio de `identity`, funcion pura,
/// la UNICA definicion de «mismo nombre de grupo») y se persiste junto a `name` (R3).
///
/// `companyId` SI lleva `@relation` —a diferencia de las FK de `WorkGroupMember`— por la razon
/// exacta que QC-47 escribio para `users.company_id`: `WorkGroup` y `Company` son los dos de
/// `identity`, no hay frontera de modulo que proteger, y asi la FK la genera Prisma en vez de
/// quedar como drift manual. `ON DELETE RESTRICT` (R10): borrar una empresa con grupos —vivos
/// o de baja— falla con `23503`.
///
/// `work_groups_company_id_idx` NO es redundante con el unico del nombre: ese es PARCIAL, y la
/// verificacion del RESTRICT tiene que ver tambien los grupos dados de baja.
/// `work_groups_id_company_id_key` es unico TRIVIALMENTE —`id` ya es la PK— y no lo pide
/// ningun requisito de negocio: existe para que la FK compuesta de `work_group_members` tenga
/// a donde apuntar (una FK compuesta exige una restriccion unica en el padre, o `42830`). Se
/// declara aqui para que NO sea drift.
/// @module identity
model WorkGroup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  companyId      String    @map("company_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId], map: "work_groups_id_company_id_key")
  @@index([companyId], map: "work_groups_company_id_idx")
  @@map("work_groups")
}

/// Pertenencia de una persona a un grupo de trabajo (QC-83). PK compuesta
/// `(work_group_id, user_id)`: la misma persona no puede estar dos veces en el mismo grupo
/// (R16), y el indice de la PK cubre la consulta caliente «quienes estan en este grupo».
/// `work_group_members_user_id_idx` sirve el sentido inverso, «en que grupos esta esta
/// persona», que la PK no cubre. Mismo patron que `RolePermission` (QC-74).
///
/// OJO 1 — las DOS FK de esta tabla son COMPUESTAS y llevan `company_id`, y por eso NINGUNA de
/// las tres columnas de referencia declara `@relation`:
///   ("work_group_id","company_id") -> work_groups("id","company_id")  ON DELETE CASCADE
///   ("user_id","company_id")       -> users("id","company_id")        ON DELETE RESTRICT
/// La fila declara UNA empresa y esa empresa tiene que ser a la vez la del grupo Y la de la
/// persona: como la igualdad es transitiva, grupo y persona son de la misma empresa POR
/// CONSTRUCCION, sin ningun estado intermedio (R13, R14, R15, decision cerrada 1). No es una
/// comprobacion que alguien pueda olvidarse de llamar; es la definicion de la tabla, y por eso
/// no la puede saltar un seed, un script ni un bug de manana.
/// Aqui NO aplica el argumento habitual del repo (evitar que un `include` cruce de modulo):
/// los tres padres son de `identity`. La razon es otra (`design.md > 2.2`): son FK COMPUESTAS
/// que COMPARTEN la columna `company_id`, no hay ninguna FK compuesta en este esquema y que
/// Prisma admita dos relaciones reutilizando el mismo escalar es un DESCONOCIDO — regla 6 de
/// `CLAUDE.md`: no se apuesta. Van escritas A MANO en el `migration.sql`.
/// LO QUE ESO CUESTA, y se acepta: las dos FK son DRIFT para Prisma. Toda migracion futura que
/// toque esta tabla va a emitir su `DROP CONSTRAINT` y HAY QUE BORRARLO A MANO del SQL
/// generado, igual que ya pasa con las FK de `orders`, `products` y `recipe_lines` (riesgo 2
/// de `design.md > 8`). Si alguien las simplifica a `FOREIGN KEY ("user_id")
/// REFERENCES "users"("id")`, todo sigue verde y la decision cerrada 1 deja de existir: lo
/// unico que se pone rojo es el test de esquema de la ficha.
///
/// OJO 2 — NO hay `deleted_at`, y es un requisito con nombre (R18, decision cerrada 4): sacar
/// a una persona del grupo BORRA la fila. Es la EXCEPCION EXPLICITA al borrado logico de QC-4,
/// y se escribe porque en la misma migracion es facil confundirla: el `deleted_at` es del
/// GRUPO, no de la pertenencia. La pertenencia no es una transaccion, es una relacion viva; el
/// historico que importa —quien era responsable de un pedido— lo congela QC-86 al asignar y no
/// lee esta tabla. Anadir aqui `deleted_at` «por coherencia» rompe ademas la PK —
/// `(work_group_id, user_id)` dejaria de ser unico al haber filas muertas— y obliga a TODA
/// lectura de miembros, para siempre, a acordarse de filtrar (riesgo 4 de `design.md > 8`).
/// Consecuencia contraintuitiva y buscada: dar de baja un grupo (R21) o una persona (R20) NO
/// borra ninguna pertenencia —ninguna FK reacciona a un `UPDATE`—; quien filtra al leer es
/// QC-84.
///
/// `createdAt`/`updatedAt` van igual (R11) aunque la fila nunca se actualice: una pertenencia
/// se crea o se borra, no se edita. `updatedAt` es NOT NULL SIN default de base —lo rellena
/// `@updatedAt` del cliente—, asi que un `INSERT` crudo que no la ponga falla.
/// @module identity
model WorkGroupMember {
  workGroupId String   @map("work_group_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([workGroupId, userId], map: "work_group_members_pkey")
  @@index([userId], map: "work_group_members_user_id_idx")
  @@map("work_group_members")
}

/// Presentacion comercial que clasifica los productos (design.md > 2.1). Catalogo
/// compartido: una misma presentacion la usan muchos productos, y no se puede borrar
/// mientras tenga alguno asignado (R14, via ON DELETE RESTRICT).
///
/// NO lleva `deletedAt`, igual que `Role` en `identity`: el borrado logico es un UPDATE y
/// una FK no puede bloquear un UPDATE, asi que la columna neutralizaria en silencio la
/// unica garantia real de R14. Ver `design.md > 9` (pregunta abierta 2).
///
/// `nameNormalized` la calcula el dominio de `inventario` (funcion pura, sin acentos ni
/// signos) y la persiste junto a `name` en toda escritura (R17). El `@@unique` es la
/// **unica** garantia de la unicidad (R18, R20, QC-20 design.md > 2.2): no hay comprobacion
/// previa por igualdad -- seria una carrera, entre el `SELECT` y el `INSERT` cabe otra
/// transaccion -- y el `PresentationRepository` no expone ningun metodo de busqueda. El
/// mensaje al usuario sale de traducir el SQLSTATE `23505` que Postgres devuelve al chocar
/// con este indice (`design.md > 11.4`).
///
/// QC-57 (`design.md > 10.2`): los indices de orden, filtro y busqueda de esta tabla NO estan
/// aqui. El GIN de trigramas `presentations_name_normalized_trgm_idx` -- que es lo que sirve una
/// busqueda por SUBCADENA, cosa que el `@@unique` btree de abajo NO hace-- y los btree
/// `presentations_name_idx`, `presentations_created_at_idx` y `presentations_updated_at_idx`
/// viven escritos a mano en `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// Prisma no modela indices GIN. Esta tabla NO tiene `deletedAt`, asi que los suyos son
/// TOTALES, no parciales.
///
/// OJO — `unitId` la anade QC-80 (R1, design.md > 3) y es la unidad de la presentacion:
/// NOT NULL y SIN `@default`. Es un campo ESCALAR uuid SIN `@relation`, y es DELIBERADO:
/// `Unit` es del modulo `unidades` y `Presentation` de `inventario`, asi que con `@relation`
/// el cliente Prisma ofreceria `include: { unit: true }` --una lectura de la tabla de
/// `unidades` desde `inventario` que NINGUNA guardia detecta, porque no es un import ni un
/// `prisma.unit`-- y ademas obligaria a declarar `presentations Presentation[]` dentro de
/// `Unit`, que es de otro modulo. Es el mismo patron que tenia `products.unit_id` (QC-32 R18)
/// y que tiene `units.company_id` (QC-76). Lo que `inventario` sepa de una unidad llega por
/// `@/lib/modules/unidades`.
/// CONSECUENCIA QUE HAY QUE SABER: la FK real `presentations_unit_id_fkey`
/// (ON DELETE RESTRICT ON UPDATE CASCADE, R2) vive escrita A MANO en
/// `db/migrations/20260911120000_presentation_unit/migration.sql` y es por tanto DRIFT para
/// Prisma. TODA MIGRACION FUTURA DE `presentations` HAY QUE REVISARLA A MANO: si el drift la
/// borra, el esquema sigue validando y el cliente sigue compilando, y no se entera nadie.
/// El `@@index` de abajo SI lo declara Prisma (R3); no es unico, muchas presentaciones
/// comparten unidad.
///
/// OJO 2 — `companyId` la anade QC-49 (R1): la presentacion es DE LA EMPRESA, sin catalogo
/// compartido (decision cerrada 3). Es NOT NULL y se aparta a conciencia de `units.companyId`
/// (QC-76), que es OPCIONAL justo para que existan las unidades DE SISTEMA: aqui no hay
/// presentaciones de sistema, y una columna opcional significaria «fila que ve todo el mundo».
/// Es un campo ESCALAR uuid SIN `@relation`, y es DELIBERADO: `Company` es del modulo
/// `identity` y `Presentation` de `inventario`, asi que con `@relation` el cliente Prisma
/// ofreceria `include: { company: true }` --una lectura de otro modulo que NINGUNA guardia
/// detecta, porque no es un import ni un `prisma.company`--. Mismo patron que `unitId`.
/// CONSECUENCIA QUE HAY QUE SABER: la FK real `presentations_company_id_fkey`
/// (ON DELETE RESTRICT ON UPDATE CASCADE) vive escrita A MANO en
/// `db/migrations/20260911130000_inventory_company_scope/migration.sql` y es por tanto DRIFT
/// para Prisma, igual que `presentations_unit_id_fkey`. Ahi vive tambien el disparador
/// `presentations_check_unit_scope`, que exige que la unidad sea de la misma empresa o de
/// sistema (R23) y que Prisma tampoco modela.
///
/// OJO 3 — la unicidad del nombre normalizado es POR EMPRESA desde QC-49 (R20): el indice
/// GLOBAL `presentations_name_normalized_key` de QC-20 CAYO, y dos empresas pueden tener cada
/// una su «Garrafa 20 L». A diferencia de los cuatro indices parciales de QC-76, este es
/// compuesto y NO parcial --`companyId` es NOT NULL--, asi que Prisma SI sabe modelarlo y se
/// declara aqui abajo: no hay drift en este punto y el `P2002` se sigue traduciendo a
/// `'duplicate'`. Volver a ponerlo sobre `nameNormalized` a secas le quitaria «Garrafa 20 L» a
/// todas las empresas menos a la primera que la cree, y en silencio.
/// @module inventario
model Presentation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String   @map("name_normalized")
  unitId         String   @map("unit_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  batches ProductBatch[]

  @@unique([companyId, nameNormalized], map: "presentations_company_name_unique")
  @@index([unitId], map: "presentations_unit_id_idx")
  @@map("presentations")
}

/// Producto del catalogo quimico. Es TAMBIEN el elemento de inventario: una sola tabla
/// (decision cerrada 1 de QC-14), con lo que HAY de el (`stock`, `qtyAlert`). Ya NO declara
/// ni presentacion (se mudo a `ProductBatch` en QC-90) ni unidad (QC-80 la elimino: se deriva
/// de la presentacion del lote mas reciente; ver OJO 2).
///
/// OJO 0 — QC-52 le QUITO `cost`, `minPurchase` y `deliveryTime` (su decision cerrada 1,
/// R1). No son propiedades de la cosa sino TERMINOS COMERCIALES, y dependen de a quien se
/// la compres: viven ahora en `SupplierCatalogLine`, una linea por proveedor. Las tres
/// columnas se fueron de la base en `<ts>_split_product_and_supplier_catalog`, con ellas se
/// fueron los CHECK `products_cost_non_negative` y `products_min_purchase_non_negative`
/// (Postgres se lleva el CHECK con la columna que solo el menciona), y el `down.sql` de esa
/// migracion los recrea A MANO porque no vuelven solos con el `ADD COLUMN`.
/// El producto CONSERVA todo lo demas: lo que la cosa ES y lo que HAY de ella.
///
/// OJO 0.1 — `imagePath` esta declarada aqui desde QC-52 (R4) y la columna existe en la base
/// desde `20260903200000_product_image_path`. Estuvo un tiempo en la base y NO en el modelo:
/// eso es DRIFT, y significaba que cualquier `prisma migrate dev` sobre `products` emitiria
/// `DROP COLUMN "image_path"` -- justo mezclado entre los DROP que si se querian. Declararla
/// no cambia la base ni un byte y desarma esa mina para toda migracion futura. Sigue SIN
/// CHECK, SIN DEFAULT y SIN indice: la forma de la ruta no esta acordada en el repo (P1).
///
/// `name` NO tiene indice unico, y es deliberado (decision cerrada 6, R16): dos productos
/// pueden llamarse igual. Se aparta a proposito del precedente de `users`.
///
/// La presentacion (`presentationId`) VIVIA aqui y se MUDO a `ProductBatch` el 2026-09-09:
/// el producto -catalogo- ya no declara en que presentacion viene; lo hace cada lote. Con ella
/// se fueron `products_presentation_id_fkey` y `products_presentation_id_idx` (la migracion
/// `<ts>_product_batches` las DROPPEA junto con su columna).
///
/// La auditoria `createdBy`/`updatedBy` VIVIA aqui (QC-20, design.md > 2.1) y se MUDO a
/// `ProductBatch` el 2026-09-09: el autor ya no se registra sobre el producto (catalogo) sino
/// sobre el lote, que es la unidad de inventario que se mueve y vence. Con ellas se fueron
/// `products_created_by_fkey` y `products_updated_by_fkey` (la migracion
/// `<ts>_product_batches` las DROPPEA junto con sus columnas). El producto ya no tiene, por
/// tanto, ningun rastro de autoria: quien lo creo o lo edito se sabe por sus lotes.
///
/// OJO 2 — el producto YA NO DECLARA UNIDAD. `unitId` vivia aqui desde QC-32 (escalar uuid
/// sin `@relation`, OPCIONAL) y QC-80 se la QUITO (R7, R21, decision cerrada del 2026-09-08):
/// con ella se fueron la columna `products.unit_id`, su indice `products_unit_id_idx` y su FK
/// `products_unit_id_fkey`, que la migracion `<ts>_presentation_unit` DROPPEA. No se perdio
/// ningun dato: la columna estaba vacia en las 7 filas vivas, comprobado contra la base.
/// La unidad de un producto se DERIVA ahora de la PRESENTACION DE SU LOTE MAS RECIENTE
/// --`created_at DESC`, desempatando por `id DESC`-- y no se almacena en ninguna columna de
/// esta tabla (R22): quien la declara es `presentations.unit_id`, que es NOT NULL desde
/// QC-80. Un producto SIN lotes no tiene unidad derivada, y eso es «ninguna», no un error
/// (R23). NO se le devuelve al producto ninguna `presentation_id` (R25): la presentacion vive
/// SOLO en `product_batches` desde QC-90. Y NO se guarda aqui una copia denormalizada
/// (QC-80 design.md > 11, alternativa B): dos sitios que dicen la unidad de un producto es
/// como se acaba con dos que discrepan.
///
/// OJO 3 — `nameNormalized` la anade QC-57 (R19, R23) y es la columna contra la que BUSCA el
/// listado, no una clave: `products.name` NO es unico (decision cerrada 6 de QC-14) y esta
/// columna NO lleva indice unico, a diferencia de las de `presentations`, `recipes`,
/// `suppliers`, `supplier_catalog_lines` y `units`. La calcula `normalizeProductName`
/// (dominio de `inventario`, funcion pura) y se persiste junto a `name` en TODA escritura;
/// no se escribe otra definicion de «mismo nombre» en el modulo. Las filas que ya existian
/// se rellenaron con el backfill de `<ts>_list_query_indexes`.
///
/// OJO 4 — los indices de orden, filtro y busqueda de esta tabla NO estan aqui y es
/// deliberado (QC-57, `design.md > 10.2`): son PARCIALES (`WHERE deleted_at IS NULL`) o GIN
/// de trigramas, y Prisma no modela ninguna de las dos cosas —mismo caso que
/// `recipes_name_unique` y `suppliers_name_unique`—. Viven escritos a mano en
/// `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// `products_name_normalized_trgm_idx`, `products_name_idx`, `products_stock_idx`,
/// `products_qty_alert_idx`, `products_created_at_idx` y `products_updated_at_idx`.
///
/// OJO 5 — `companyId` la anade QC-49 (R1): todo producto es DE UNA EMPRESA, NOT NULL. Es un
/// campo ESCALAR uuid SIN `@relation`, y es DELIBERADO: `Company` es del modulo `identity` y
/// `Product` de `inventario`, asi que con `@relation` el cliente Prisma ofreceria
/// `include: { company: true }` --una lectura de otro modulo que NINGUNA guardia detecta,
/// porque no es un import ni un `prisma.company`--. Mismo patron que `units.company_id`
/// (QC-76) y que `presentations.unit_id` (QC-80).
/// CONSECUENCIA QUE HAY QUE SABER: la FK real `products_company_id_fkey`
/// (ON DELETE RESTRICT ON UPDATE CASCADE) vive escrita A MANO en
/// `db/migrations/20260911130000_inventory_company_scope/migration.sql` y es por tanto DRIFT
/// para Prisma. TODA MIGRACION FUTURA DE `products` HAY QUE REVISARLA A MANO: si el drift la
/// borra, el esquema sigue validando y el cliente sigue compilando, y no se entera nadie.
/// El `@@index` de abajo SI lo declara Prisma (R10) y NO es parcial a proposito: por el pasa la
/// verificacion del `RESTRICT`, que tiene que ver tambien los productos con borrado logico.
/// `products` SIGUE SIN unicidad de nombre (R21): dos productos pueden llamarse igual DENTRO de
/// la misma empresa, como desde QC-20. Lo que si acota QC-49 es la RESOLUCION por nombre del
/// alta, que mira solo los vivos de la empresa del actor: eso es filtro del repositorio, no
/// restriccion del esquema.
/// @module inventario
model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  stock          Int?
  qtyAlert       Int?      @map("qty_alert")
  imagePath      String?   @map("image_path")
  companyId      String    @map("company_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  batches ProductBatch[]

  @@index([companyId], map: "products_company_id_idx")
  @@map("products")
}

/// Lote de un producto del inventario (2026-09-09). Un producto puede tener VARIOS lotes
/// (1:N), cada uno con su propia existencia (`stock`), su numero de lote (`lot`, OPCIONAL) y
/// su fecha de vencimiento (`expiryDate`, OPCIONAL). Es la unidad sobre la que se lleva la
/// autoria: `createdBy`/`updatedBy` se mudaron AQUI desde `products`.
///
/// OJO — `createdBy`/`updatedBy` son FK REALES a `users` declaradas como ESCALARES SIN
/// `@relation` a proposito, igual que las que tuvo `products` (QC-20 design.md > 2.1) y las
/// de `recipes`/`suppliers`/`orders`: con `@relation`, el cliente Prisma habilitaria
/// `include: { createdByUser: true }` desde `inventario` —una lectura de `users` de otro
/// modulo que ninguna guardia detecta, porque no es un import ni un `prisma.user`—. Las FK
/// viven escritas a mano en la migracion `<ts>_product_batches`
/// (`product_batches_created_by_fkey`, `product_batches_updated_by_fkey`) y son DRIFT para
/// Prisma: toda migracion futura de `product_batches` hay que revisarla a mano. Son anulables
/// por el mismo motivo que las de `products`: NULL significa «no lo creo una persona», no «se
/// perdio el dato».
///
/// `productId` SI lleva `@relation` —a diferencia de `recipe_lines.product_id`— porque
/// `Product` y `ProductBatch` son los dos de `inventario`: no hay frontera de modulo que
/// proteger, asi que la FK la genera Prisma en vez de quedar como drift. `ON DELETE RESTRICT`
/// (mismo criterio que tenia `products.presentation_id`): el borrado de producto es LOGICO y
/// nunca dispara esta FK en operacion normal, pero un borrado fisico con lotes vivos debe ser
/// ruidoso, no arrastrarlos en silencio.
///
/// `presentationId` SI lleva `@relation` por la misma razon: `ProductBatch` y `Presentation`
/// son los dos de `inventario`. Es NOT NULL sin `@default` (decision 2026-09-09): todo lote
/// declara su presentacion, que es la que se mudo aqui desde `products`.
///
/// `stock` es NOT NULL sin `@default`: un lote nace con su cantidad, la ausencia no es un
/// valor valido (a diferencia de `products.stock`, que conserva su propia columna anulable).
/// El CHECK `product_batches_stock_non_negative` (escrito a mano en la migracion) replica el
/// de `products_stock_non_negative`: un lote no puede tener existencia negativa.
///
/// `unitCost` es el coste unitario del lote: `Decimal(14,4)` NOT NULL (misma precision que el
/// dinero de QC-33), nunca coma flotante (`docs/architecture.md > Dominio` n.º 4). El CHECK
/// `product_batches_unit_cost_positive` (escrito a mano en la migracion, mismo patron que
/// `supplier_catalog_lines_cost_positive` de QC-43) lo exige `> 0`. NO hay columna de coste
/// TOTAL a proposito, igual que en pedidos: `totalCost` es `stock * unitCost` y se calcula al
/// leer, para que no pueda contradecir a sus factores.
///
/// `lot` y `expiryDate` son OPCIONALES: no todo lote lleva numero ni fecha de vencimiento.
/// `expiryDate` es `@db.Date` (fecha sin hora), como `users.birth_date`.
///
/// OJO — `companyId` la anade QC-49 (R2) y es COLUMNA PROPIA DEL LOTE, no se deriva por `join`
/// con su producto (decision cerrada 2): QC-81 necesita la unicidad `(company_id, lot)` y un
/// indice no puede indexar la columna de otra tabla. NOT NULL. Es un campo ESCALAR uuid SIN
/// `@relation`, por el mismo motivo que `createdBy`/`updatedBy`: `Company` es de `identity` y
/// `ProductBatch` de `inventario`, y con `@relation` el cliente ofreceria
/// `include: { company: true }`, un cruce de modulos que ninguna guardia detecta.
/// CONSECUENCIA QUE HAY QUE SABER: la FK real `product_batches_company_id_fkey`
/// (ON DELETE RESTRICT ON UPDATE CASCADE) vive escrita A MANO en
/// `db/migrations/20260911130000_inventory_company_scope/migration.sql`, junto con las dos de
/// auditoria, y es DRIFT para Prisma. Ahi vive tambien el disparador
/// `product_batches_check_company`, que exige que la empresa del lote coincida con la de su
/// producto Y con la de su presentacion (R22) --lo que ni un CHECK ni una FK pueden decir, y
/// que Prisma tampoco modela--. El `@@index` de abajo SI lo declara Prisma (R10).
/// @module inventario
model ProductBatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  presentationId String    @map("presentation_id") @db.Uuid
  stock          Int
  unitCost       Decimal   @map("unit_cost") @db.Decimal(14, 4)
  lot            String?   @map("lot")
  expiryDate     DateTime? @map("expiry_date") @db.Date
  companyId      String    @map("company_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([companyId], map: "product_batches_company_id_idx")
  @@index([productId], map: "product_batches_product_id_idx")
  @@index([presentationId], map: "product_batches_presentation_id_idx")
  @@index([createdBy], map: "product_batches_created_by_idx")
  @@index([updatedBy], map: "product_batches_updated_by_idx")
  @@map("product_batches")
}

/// Receta (formula) del ERP quimico. Borrado LOGICO: `deletedAt` NULL = receta viva.
///
/// OJO 1 — `createdBy` y `updatedBy` son FK REALES a `users`, pero se declaran como
/// ESCALARES SIN `@relation` a proposito (decision cerrada 3, R19): la FK esta escrita a
/// mano en `migration.sql`. Asi la base garantiza la integridad y, a la vez, el cliente
/// Prisma NO puede atravesar de `recetas` a `users` con un `include`. La guardia de modulos
/// NO detectaria ese cruce, porque no es un import.
/// Son ANULABLES (decision cerrada 22, R33): NULL significa «no la creo una persona»
/// —una importacion, un seed—, no «se perdio el dato».
///
/// OJO 2 — la unicidad del nombre NO esta aqui como `@unique` y es deliberado: es un indice
/// unico PARCIAL (`WHERE deleted_at IS NULL`) sobre `name_normalized`, y Prisma no modela
/// indices parciales. Vive escrito a mano en `migration.sql` (`recipes_name_unique`).
///
/// OJO 3 — QC-57 (`design.md > 10.2`): los indices de orden, filtro y busqueda tampoco estan
/// aqui, por la misma razon que `recipes_name_unique`: son PARCIALES
/// (`WHERE deleted_at IS NULL`) o GIN de trigramas. Escritos a mano en
/// `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// `recipes_name_normalized_trgm_idx`, `recipes_name_idx`, `recipes_created_at_idx` y
/// `recipes_updated_at_idx`.
/// @module recetas
model Recipe {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  description    String?
  steps          Json      @default("[]")
  imagePath      String?   @map("image_path")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  lines RecipeLine[]

  @@index([createdBy], map: "recipes_created_by_idx")
  @@index([updatedBy], map: "recipes_updated_by_idx")
  @@map("recipes")
}

/// Linea de una receta: la pareja receta-producto como ENTIDAD PROPIA, con su cantidad y su
/// unidad (decision cerrada 12).
///
/// NO lleva `deletedAt` a proposito (decision cerrada 5, R24): la linea es parte de la
/// receta, no un hecho historico, y corregir una formula es una edicion normal.
///
/// OJO — `productId` es una FK REAL a `products` declarada como ESCALAR SIN `@relation`
/// (decision cerrada 3 aplicada a la frontera con `inventario`, R19). La FK esta escrita a
/// mano en `migration.sql`. Lo que `recetas` sabe del producto llega por el contrato publico
/// `@/lib/modules/inventario`, nunca por un `include` ni por `prisma.product`.
///
/// OJO 2 — `unitId` (QC-32, decision cerrada 13, R11, R18) es exactamente lo mismo en la
/// frontera con el modulo `unidades`: campo ESCALAR uuid SIN `@relation`, con la FK real
/// (`recipe_lines_unit_id_fkey`, ON DELETE RESTRICT ON UPDATE CASCADE) escrita A MANO en el
/// SQL de la migracion `<ts>_units_catalog` (`specs/QC-32-modelo-unidades/design.md`
/// secciones 4.3 y 8.1). Con `@relation`, Prisma habilitaria `include: { unit: true }` desde
/// `recetas` —un cruce de frontera que la guardia de modulos NO ve, porque no es un import—
/// y obligaria a declarar `lines RecipeLine[]` dentro de `Unit`, que es de otro modulo. Es
/// DRIFT para Prisma: toda migracion futura de `recipe_lines` hay que revisarla a mano para
/// que no borre esa FK. Antes de QC-32 esto era `unit String`, texto libre; ahora es una
/// referencia al catalogo, OBLIGATORIA (decision cerrada 8, R11) y sigue siendo ANOTATIVA:
/// no hay conversion entre unidades y la linea no hereda la del producto (R14).
/// @module recetas
model RecipeLine {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 4)
  unitId    String   @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([recipeId, productId], map: "recipe_lines_recipe_id_product_id_key")
  @@index([productId], map: "recipe_lines_product_id_idx")
  @@index([unitId], map: "recipe_lines_unit_id_idx")
  @@map("recipe_lines")
}

/// Proveedor del ERP quimico. Borrado LOGICO: `deletedAt` NULL = proveedor vivo.
/// NO hay estado activo/inactivo aparte (decision cerrada 10, R26): un segundo estado que
/// nadie sabe distinguir del primero es deuda, no informacion.
///
/// OJO 1 — `createdBy` y `updatedBy` son FK REALES a `users`, pero se declaran como
/// ESCALARES SIN `@relation` a proposito (decision cerrada 14, R22): la FK esta escrita a
/// mano en `migration.sql`. Asi la base garantiza la integridad y, a la vez, el cliente
/// Prisma NO puede atravesar de `proveedores` a `users` con un `include`. La guardia de
/// modulos NO detectaria ese cruce, porque no es un import.
/// Son ANULABLES: NULL significa «no lo creo una persona» —una importacion, un seed—, no
/// «se perdio el dato». Heredado de QC-24 (decision cerrada 22 de aquella ficha).
///
/// OJO 2 — la unicidad del nombre NO esta aqui como `@unique` y es deliberado: es un indice
/// unico PARCIAL (`WHERE deleted_at IS NULL`) sobre `name_normalized`, y Prisma no modela
/// indices parciales. Vive escrito a mano en `migration.sql` (`suppliers_name_unique`).
///
/// OJO 3 — la regla cruzada «al menos telefono o correo» (decision cerrada 7, R4) es un
/// CHECK en la base (`suppliers_contact_required`) y Prisma NO modela CHECK: por eso las dos
/// columnas se ven aqui como simplemente opcionales. Vive escrito a mano en `migration.sql`.
///
/// OJO 4 — QC-57 (`design.md > 10.2`): los indices de orden, filtro y busqueda tampoco estan
/// aqui, por la misma razon que `suppliers_name_unique`: son PARCIALES
/// (`WHERE deleted_at IS NULL`) o GIN de trigramas. Escritos a mano en
/// `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// `suppliers_name_normalized_trgm_idx`, `suppliers_name_idx`, `suppliers_created_at_idx` y
/// `suppliers_updated_at_idx`.
/// @module proveedores
model Supplier {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  phone          String?
  email          String?
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  catalogLines SupplierCatalogLine[]

  @@index([createdBy], map: "suppliers_created_by_idx")
  @@index([updatedBy], map: "suppliers_updated_by_idx")
  @@map("suppliers")
}

/// Linea del catalogo de un proveedor: COMO VENDE ESTE PROVEEDOR ESTA COSA. Entidad propia,
/// con su nombre, su presentacion, su unidad, su costo, su minimo de compra y su tiempo de
/// entrega (QC-42 decision cerrada 3, reformada entera por QC-52).
///
/// OJO 0 — LA LINEA YA NO CONOCE EL PRODUCTO. QC-52 le quito `productId`, su FK
/// `supplier_catalog_lines_product_id_fkey` y su indice unico
/// `supplier_catalog_lines_supplier_id_product_id_key` (su decision cerrada 3, R9, R18). NO
/// hay vinculo entre esta tabla y `products`, ni siquiera opcional, y se descarto
/// expresamente una referencia anulable: es lo que permite que el catalogo de un proveedor
/// incluya cosas que aun no tienes dadas de alta. CONSECUENCIA ACEPTADA Y ESCRITA: el sistema
/// NO PUEDE responder «a cuanto me vende cada proveedor este producto» ni comparar precios
/// entre proveedores. Si algun dia se quiere, es ficha propia y la via razonable es una tabla
/// de equivalencias, no devolver esta columna.
/// A cambio, la linea gana la estructura del producto MENOS `stock` y `qty_alert` -- cuanto
/// tienes es tuyo, no del proveedor--: `name`, `nameNormalized`, `presentationId`, `unitId`,
/// `imagePath` y `deletedAt`.
///
/// OJO 1 — LA IDENTIDAD DE LA LINEA es ahora `(supplier_id, name_normalized, presentation_id)`
/// sobre las VIVAS. NO esta aqui como `@@unique` y es deliberado: es un indice unico PARCIAL
/// (`WHERE deleted_at IS NULL`) y Prisma no modela indices parciales. Vive escrito a mano en
/// `<ts>_split_product_and_supplier_catalog/migration.sql`
/// (`supplier_catalog_lines_name_presentation_unique`), mismo patron que `suppliers_name_unique`
/// y `recipes_name_unique`. Es la UNICA garantia de la unicidad (R15): no hay `SELECT` previo
/// por igualdad -- seria una carrera-- y el puerto no expone busqueda por nombre. El mensaje al
/// usuario sale de traducir el SQLSTATE `23505`. `presentationId` es OBLIGATORIA por eso mismo:
/// forma parte de la clave. Que `deletedAt` libere la combinacion es R17, y por eso el indice
/// es parcial y no total como era el de `(supplier_id, product_id)`.
///
/// OJO 2 — `presentationId`, `unitId`, `createdBy` y `updatedBy` son FK REALES -a
/// `presentations`, `units` y `users`- declaradas como ESCALARES SIN `@relation` (QC-42
/// decision cerrada 13/14, QC-52 decision cerrada 10, R30). Las cuatro estan escritas A MANO
/// en SQL. Con `@relation`, el cliente Prisma ofreceria `include: { presentation: true }`
/// desde `proveedores` -- una lectura de la tabla de otro modulo que NINGUNA guardia detecta,
/// porque no es un import ni un `prisma.presentation`-- y ademas obligaria a declarar
/// `catalogLines SupplierCatalogLine[]` dentro de `Presentation`, `Unit` y `User`, que son de
/// otros modulos. Es por tanto DRIFT para Prisma: TODA MIGRACION FUTURA sobre esta tabla hay
/// que revisarla A MANO para que no emita un `DROP CONSTRAINT` sobre esas cuatro FK. Las dos
/// nuevas van `ON DELETE RESTRICT ON UPDATE CASCADE`, no `CASCADE` ni `SET NULL`:
/// `presentations` no tiene borrado logico, y el RESTRICT es justo lo que impide que borrar
/// una presentacion deje lineas apuntando al vacio.
///
/// OJO 3 — `deletedAt` la gana QC-52 (su decision cerrada 5, R21): borrado LOGICO, la fila
/// nunca se elimina. Al dar de baja un proveedor sus lineas caen con el, en la MISMA
/// transaccion y con LA MISMA MARCA DE TIEMPO (R20). El `onDelete: Cascade` hacia `suppliers`
/// se conserva tal cual, pero ya no es la politica: es solo la red de un borrado FISICO -- una
/// purga, un `down.sql`--, y no se dispara nunca en operacion normal porque ninguna FK
/// reacciona a un UPDATE.
///
/// OJO 4 — MANDAN LOS TIPOS ESTRICTOS DE LA LINEA, no los del producto (decision cerrada 6):
/// `cost` sigue NOT NULL y `> 0`, y `minPurchase` sigue `Decimal(14,4)`, no entero. Copiar el
/// producto al pie de la letra habria hecho el costo opcional y el minimo entero. Los CHECK de
/// `cost` (`> 0` desde QC-43), `min_purchase` y `delivery_time` (`>= 0`) son SQL escrito a
/// mano: Prisma no modela CHECK. Ver `design.md > 4.4` de QC-42 y `> 2.2` de QC-43.
///
/// `nameNormalized` la calcula `normalizeSupplierName` (dominio de `proveedores`, funcion
/// pura) y se persiste junto a `name` en toda escritura (R14). No se escribe otra: dos
/// definiciones de «mismo nombre» en el mismo modulo divergen.
///
/// `imagePath` va SIN CHECK, SIN DEFAULT y SIN indice, igual que `products.image_path`: la
/// forma de la ruta no esta acordada en el repo y no hay flujo de subida todavia (P1).
///
/// OJO 5 — QC-57 (`design.md > 10.2`): los indices de orden, filtro y busqueda tampoco estan
/// aqui, por la misma razon que `supplier_catalog_lines_name_presentation_unique`: son
/// PARCIALES (`WHERE deleted_at IS NULL`) o GIN de trigramas. Escritos a mano en
/// `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// `supplier_catalog_lines_name_normalized_trgm_idx` -- el unico que sirve una busqueda por
/// SUBCADENA: en el indice unico de arriba `name_normalized` NO va en cabeza--,
/// `supplier_catalog_lines_name_idx`, `_cost_idx`, `_min_purchase_idx`, `_delivery_time_idx`,
/// `_created_at_idx` y `_updated_at_idx`.
/// @module proveedores
model SupplierCatalogLine {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  presentationId String    @map("presentation_id") @db.Uuid
  unitId         String?   @map("unit_id") @db.Uuid
  imagePath      String?   @map("image_path")
  cost           Decimal   @db.Decimal(14, 4)
  minPurchase    Decimal?  @map("min_purchase") @db.Decimal(14, 4)
  deliveryTime   Int?      @map("delivery_time")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([presentationId], map: "supplier_catalog_lines_presentation_id_idx")
  @@index([unitId], map: "supplier_catalog_lines_unit_id_idx")
  @@index([createdBy], map: "supplier_catalog_lines_created_by_idx")
  @@index([updatedBy], map: "supplier_catalog_lines_updated_by_idx")
  @@map("supplier_catalog_lines")
}

/// Catalogo de unidades de medida (QC-32). Modulo propio `unidades`: `inventario`,
/// `recetas` y lo que venga lo consumen por su contrato publico `@/lib/modules/unidades`,
/// nunca por esta tabla.
///
/// NO lleva `deletedAt` a proposito (decision cerrada 11 de QC-32, R8; QC-76 R32 lo
/// reafirma), igual que `Role` y `Presentation`: el borrado logico es un UPDATE y una FK no
/// puede bloquear un UPDATE, asi que la columna neutralizaria en silencio la unica garantia
/// real de R13 -- y, desde QC-76, tambien la del `units_unit_id_fkey`.
///
/// `nameNormalized` la calcula el dominio de `unidades` (`normalizeUnitName`, funcion pura) y
/// se persiste junto a `name` en toda escritura. La unicidad la garantiza un INDICE, nunca una
/// comprobacion previa por igualdad -- seria una carrera.
///
/// QC-76 (`design.md > 2.1` y `2.3`): AQUI NO HAY, NI DEBE HABER, NINGUN `@@unique` NI
/// `@unique`. La unicidad del nombre normalizado y la del simbolo pasaron a ser POR AMBITO
/// --dentro de la empresa, y las de sistema entre ellas (R14, R15)--, y eso son CUATRO indices
/// unicos PARCIALES (`units_company_name_unique`, `units_system_name_unique`,
/// `units_company_symbol_unique`, `units_system_symbol_unique`) que Prisma no sabe modelar.
/// Viven escritos a mano en
/// `db/migrations/20260907190000_units_equivalence_and_scope/migration.sql`, junto con los
/// tres CHECK, las dos FK y el disparador `units_check_derivation`. Mismo patron que
/// `users_email_unique` (QC-4) y `companies_name_unique` (QC-47).
/// Volver a declarar aqui `@@unique([nameNormalized])` NO es cosmetico: el siguiente
/// `prisma migrate dev` generaria de nuevo el indice GLOBAL `units_name_normalized_key` y la
/// unicidad dejaria de ser por ambito EN SILENCIO --dos empresas no podrian tener cada una su
/// «kilogramo»--, rompiendo R14 sin que nada deje de compilar. Lo vigila
/// `tests/unit/unidades/schema/unidades-schema.test.ts`.
///
/// `companyId` y `baseUnitId` son ESCALARES SIN `@relation` a proposito (`design.md > 2.1`):
/// `Company` es de `identity`, asi que ninguna consulta puede atravesar de una unidad a una
/// empresa con un `include` --mismo criterio que `products.unit_id` (QC-32 R18)--, y la
/// auto-referencia obligaria a declarar un lado inverso (`derived Unit[]`) que nadie consulta:
/// la conversion se calcula en el dominio a partir de dos descriptores, nunca navegando.
/// Las FK reales (`units_company_id_fkey`, `units_unit_id_fkey`, las dos
/// `ON DELETE RESTRICT ON UPDATE CASCADE`) las escribe la migracion a mano.
///
/// `factor` dice cuantas unidades de `baseUnitId` caben en una de esta (R3): `decimal(14,4)`,
/// exacto, nunca coma flotante, la misma precision que el dinero de QC-33. Va con `baseUnitId`
/// JUNTOS O NINGUNO, y eso lo garantiza `units_derivation_pair_check` (R2), no el esquema.
///
/// QC-57 (`design.md > 10.2`): los indices de orden, filtro y busqueda NO estan aqui. El GIN
/// de trigramas `units_name_normalized_trgm_idx` -- lo que sirve una busqueda por SUBCADENA,
/// que un btree no hace-- y los btree `units_name_idx`,
/// `units_symbol_idx` (orden, NO unicidad), `units_created_at_idx` y `units_updated_at_idx`
/// viven escritos a mano en
/// `db/migrations/20260904160000_list_query_indexes/migration.sql`. Esta tabla NO tiene
/// `deletedAt`, asi que los suyos son TOTALES, no parciales.
/// @module unidades
model Unit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String   @map("name_normalized")
  symbol         String?
  companyId      String?  @map("company_id") @db.Uuid
  baseUnitId     String?  @map("unit_id") @db.Uuid
  factor         Decimal? @db.Decimal(14, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId], map: "units_company_id_idx")
  @@index([baseUnitId], map: "units_unit_id_idx")
  @@map("units")
}

/// Estado del pedido (QC-33, decision cerrada 4). Conjunto CERRADO en el propio esquema:
/// anadir un valor es una migracion del tipo en Postgres, y el humano lo asumio a conciencia.
/// Se aparta a proposito de `DocumentType` (QC-4), que resolvio el mismo problema con una
/// tabla porque el conjunto DEBIA crecer sin migrar; aqui no debe.
/// Que transiciones son validas NO se decide aqui: es QC-34 (R19).
enum OrderStatus {
  PENDIENTE
  EN_CURSO
  ENTREGADO
  /// QC-34 (decision cerrada 3): CUARTO valor, anadido por la migracion `_order_cancellation`
  /// con `ALTER TYPE ... ADD VALUE`. Es el coste que QC-33 asumio al elegir enum en vez de
  /// tabla. Va el ULTIMO: el orden de declaracion de este tipo no significa nada —a diferencia
  /// del de `OrderPriority`—, pero reordenarlo obligaria a recrear el tipo en vez de anadir un
  /// valor. `CANCELADO` es FINAL: no se sale de el (QC-34 R21, R22).
  CANCELADO
}

/// Prioridad del pedido (QC-33, decision cerrada 4). EL ORDEN DE DECLARACION ES EL ORDEN DE
/// LA PRIORIDAD, de menor a mayor: reordenar estas cuatro lineas cambia el significado del
/// dato y el `ORDER BY priority` de cualquier consulta futura. Postgres ordena un enum por su
/// orden de declaracion, no alfabeticamente.
enum OrderPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

/// Pedido del ERP (QC-33). Una sola LINEA: receta, cantidad, unidad y precio UNITARIO
/// (decision cerrada 1). No hay cabecera ni items, y no hay cliente ni destinatario
/// (decision cerrada 8, R3): eso es deliberado y anadirlo despues obliga a decidir que
/// cliente llevaban los pedidos ya cargados.
///
/// NO hay columna de total y es deliberado (decision cerrada 5, R10): el total es
/// `quantity * unitPrice`, se calcula al leer y no se guarda, para que no pueda contradecir
/// a sus factores. Tampoco hay impuestos ni facturacion: este ERP no factura
/// (`docs/architecture.md > Dominio`, pregunta abierta 4, cerrada por esta ficha).
///
/// NO hay columna de fecha de solicitud (decision cerrada 10, R4): la pone el sistema y no se
/// edita, o sea que es exactamente `createdAt`. Dos columnas con el mismo dato solo divergen.
///
/// OJO 1 — el correlativo son DOS columnas, `orderYear` + `orderSequence`, con indice unico
/// COMPUESTO y TOTAL (R21, R22). NO es parcial, a diferencia de `recipes_name_unique`: un
/// pedido borrado logicamente conserva su numero y NO lo libera (decision cerrada 9). El
/// numero visible `2026-0000001` NO se guarda: lo compone `formatOrderNumber` del dominio (R24).
/// `orderYear` es el ano de `createdAt` MEDIDO EN UTC, y lo garantiza el CHECK
/// `orders_order_year_matches_created_at` (decision cerrada 28, R41): quien inserte con otro
/// reloj se lleva un 23514.
///
/// OJO 2 — `recipeId`, `createdBy` y `updatedBy` son FK REALES pero se declaran como
/// ESCALARES SIN `@relation` a proposito (decision cerrada 17 y su aplicacion a las otras dos
/// fronteras, R33): las TRES FK estan escritas A MANO en `migration.sql`. Eran cuatro hasta el
/// 2026-09-07, cuando la decision humana de quitar la unidad y el precio unitario del pedido se
/// llevo `unit_id`, `unit_price` y con ellos `orders_unit_id_fkey`
/// (`db/migrations/20260907120000_orders_drop_unit_and_unit_price`). Asi la base
/// garantiza la integridad y, a la vez, el cliente Prisma NO puede atravesar de `pedidos` a
/// `recetas`, `unidades` ni `users` con un `include`. La guardia de modulos NO detectaria ese
/// cruce, porque no es un import. Es DRIFT para Prisma: toda migracion futura de `orders` hay
/// que revisarla a mano para que no borre las cuatro FK, los cinco CHECK ni el RLS.
///
/// `createdBy`/`updatedBy` son ANULABLES (decision cerrada 18, R26): NULL significa «no lo creo
/// una persona» —una importacion, un seed—, no «se perdio el dato».
///
/// OJO 3 — QC-57 (`design.md > 10.2`): los indices de orden y filtro de esta tabla NO estan
/// aqui porque son PARCIALES (`WHERE deleted_at IS NULL`) y Prisma no los modela. Escritos a
/// mano en `db/migrations/20260904160000_list_query_indexes/migration.sql`:
/// `orders_status_idx`, `orders_priority_idx`, `orders_created_at_idx` y `orders_quantity_idx`
/// (`orders_unit_price_idx` cayo con la columna el 2026-09-07). NO hay indice de busqueda: `orders` no tiene `name` y la
/// busqueda se omite (R17). El correlativo lo ordena `orders_order_year_order_sequence_key`,
/// que ya existia.
/// @module pedidos
model Order {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderYear          Int           @map("order_year")
  orderSequence      Int           @map("order_sequence")
  recipeId           String        @map("recipe_id") @db.Uuid
  quantity           Decimal       @db.Decimal(14, 4)
  priority           OrderPriority @default(BAJA)
  status             OrderStatus   @default(PENDIENTE)
  /// QC-34 (decision cerrada 4, R27, R30): motivo de la cancelacion. ANULABLE, porque solo
  /// existe en un pedido cancelado, y `TEXT` SIN longitud: el tope de 500 vive en `zod`
  /// (`order-input.ts`), no en el tipo de la columna —cambiarlo no puede ser una migracion—.
  /// Que exista si y solo si `status = 'CANCELADO'` lo garantiza el CHECK
  /// `orders_cancellation_reason_matches_status`, escrito a mano en la migracion.
  cancellationReason String?       @map("cancellation_reason")
  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  @@unique([orderYear, orderSequence], map: "orders_order_year_order_sequence_key")
  @@index([recipeId], map: "orders_recipe_id_idx")
  @@index([createdBy], map: "orders_created_by_idx")
  @@index([updatedBy], map: "orders_updated_by_idx")
  @@map("orders")
}
