// Vive en `db/` y no en `prisma/`: la ruta se declara en `prisma.config.ts`.

datasource db {
  provider  = "postgresql"
  // Runtime: pooler transaccional (:6543).
  url       = env("DATABASE_URL")
  // Migraciones: modo sesion (:5432). `prisma.config.ts` la iguala a DATABASE_URL si no esta definida.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Sin `deletedAt`: un tipo no se borra, se desactiva con `isActive`.
/// @module identity
model DocumentType {
  code      String   @id
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users User[]

  @@map("document_types")
}

/// Sin `deletedAt`: el borrado logico es un UPDATE, que ninguna FK bloquea, y dejaria sin efecto el
/// RESTRICT que impide borrar un rol en uso.
/// @module identity
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// `code` es clave de texto para que `role_permissions` se lea sin JOIN. La aplicacion no administra
/// este catalogo: lo siembra `seedInitialAccess` y cambia por migracion.
/// @module identity
model Permission {
  code        String   @id
  module      String
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

/// Sin columna de empresa: el permiso cuelga del rol y de nada mas.
/// @module identity
model RolePermission {
  roleId         String   @map("role_id") @db.Uuid
  permissionCode String   @map("permission_code")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

/// Enum y no tabla: el conjunto es cerrado a proposito y anadir un valor es una migracion.
/// El orden coincide con `USER_ACCOUNT_STATUSES`, y un test los compara en orden.
enum UserAccountStatus {
  active
  pending
  inactive
  blocked
}

/// Las unicidades de correo, nombre de usuario y documento no son `@unique`: son indices unicos
/// funcionales (`lower(...)`), parciales (`WHERE deleted_at IS NULL`) y con `company_id` delante,
/// escritos a mano en la migracion. Un `@unique` aqui distinguiria mayusculas y quemaria el valor
/// de los usuarios dados de baja. `users_company_id_idx` no sobra: el RESTRICT al borrar una empresa
/// tiene que ver tambien a los dados de baja, que esos indices parciales no cubren.
/// @module identity
model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstNames       String    @map("first_names")
  lastNames        String    @map("last_names")
  birthDate        DateTime  @map("birth_date") @db.Date
  email            String
  phone            String
  documentTypeCode String    @map("document_type_code")
  documentNumber   String    @map("document_number")
  username         String
  passwordHash     String    @map("password_hash")
  roleId           String    @map("role_id") @db.Uuid
  /// Con `@relation`, a diferencia de otras FK: `User` y `Company` son del mismo modulo.
  companyId        String    @map("company_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockLevel           Int       @default(0) @map("lock_level")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)

  /// El nombre evita el segmento `password`: la guardia de contrasenas en claro lo marcaria.
  mustChangeCredential Boolean @default(false) @map("must_change_credential")

  accountStatus UserAccountStatus @default(pending) @map("account_status")

  accountStatusChangedAt DateTime @default(now()) @map("account_status_changed_at") @db.Timestamptz(6)

  /// NULL = lo cambio el sistema, no una persona. La FK `users_account_status_changed_by_fkey` esta
  /// escrita a mano, sin `@relation`, y es drift para Prisma.
  accountStatusChangedBy String? @map("account_status_changed_by") @db.Uuid

  /// Toda sesion con `iat` anterior o igual a este instante es invalida. Las escrituras lo truncan al
  /// segundo, que es la granularidad de `iat`.
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from") @db.Timestamptz(6)

  documentType          DocumentType           @relation(fields: [documentTypeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  role                  Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credentialSetupTokens CredentialSetupToken[]
  revokedSessions       RevokedSession[]

  @@unique([id, companyId], map: "users_id_company_id_key")
  @@index([roleId], map: "users_role_id_idx")
  @@index([companyId], map: "users_company_id_idx")
  @@index([documentTypeCode], map: "users_document_type_code_idx")
  /// Postgres no indexa solo el lado hijo de una FK, y el RESTRICT lo recorre en cada borrado.
  @@index([accountStatusChangedBy], map: "users_account_status_changed_by_idx")
  @@map("users")
}

/// La unicidad del nombre no es `@@unique`: `companies_name_unique` es un indice funcional
/// (`lower(...)`) y parcial (`WHERE deleted_at IS NULL`) escrito a mano en la migracion. Con
/// `@@unique` pasaria a ser total y una empresa dada de baja quemaria su nombre.
/// @module identity
model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  users      User[]
  workGroups WorkGroup[]

  @@map("companies")
}

/// La unicidad del nombre no es `@@unique`: `work_groups_name_unique` es compuesto con
/// `company_id`, funcional y parcial, escrito a mano en la migracion. Con `@@unique` seria total y
/// un grupo dado de baja quemaria su nombre. `work_groups_id_company_id_key` es trivialmente unico:
/// existe como destino de las FK compuestas que llevan `company_id`.
/// @module identity
model WorkGroup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  companyId      String    @map("company_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId], map: "work_groups_id_company_id_key")
  @@index([companyId], map: "work_groups_company_id_idx")
  @@map("work_groups")
}

/// Las dos FK son compuestas con `company_id` y comparten esa columna, y por eso van escritas a mano
/// y sin `@relation`: asi grupo y persona son de la misma empresa por construccion. Son drift: toda
/// migracion generada sobre esta tabla emitira su `DROP CONSTRAINT`, y hay que borrarlo a mano.
/// Sin `deleted_at`: sacar a alguien del grupo borra la fila, y con filas muertas la PK dejaria de
/// ser unica.
/// @module identity
model WorkGroupMember {
  workGroupId String   @map("work_group_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([workGroupId, userId], map: "work_group_members_pkey")
  @@index([userId], map: "work_group_members_user_id_idx")
  @@map("work_group_members")
}

/// Guarda la huella SHA-256 del enlace, nunca el secreto. «Un solo enlace vivo por persona» es el
/// indice unico parcial `credential_setup_tokens_one_live_per_user`, escrito a mano porque Prisma no
/// modela indices parciales: un `@@unique([userId])` lo volveria total.
/// @module identity
model CredentialSetupToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenDigest  String    @map("token_digest")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tokenDigest], map: "credential_setup_tokens_token_digest_key")
  @@index([userId], map: "credential_setup_tokens_user_id_idx")
  @@map("credential_setup_tokens")
}

/// Sin `updated_at` ni `deleted_at`: una sesion cerrada es un hecho inmutable, y lo unico que le
/// pasa despues es el borrado fisico de la purga.
/// @module identity
model RevokedSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Caducidad natural del token cerrado: pasada, la fila ya no protege de nada y se puede purgar.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId], map: "revoked_sessions_session_id_key")
  @@index([userId, expiresAt], map: "revoked_sessions_user_id_expires_at_idx")
  @@map("revoked_sessions")
}

/// Sin `deletedAt`: el borrado logico es un UPDATE, que ninguna FK bloquea, y dejaria sin efecto el
/// RESTRICT que impide borrar una presentacion en uso. `unitId` y `companyId` no llevan `@relation`
/// porque apuntan a otros modulos y un `include` cruzaria la frontera sin que ninguna guardia lo vea;
/// sus FK estan escritas a mano y son drift. El disparador `presentations_check_unit_scope` y los
/// indices de busqueda y orden solo existen en las migraciones.
/// `presentations_company_id_id_key` es la clave candidata a la que apunta la FK COMPUESTA de
/// `supplier_catalog_lines` hacia la presentacion: quitarla la rompe.
/// @module inventario
model Presentation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String   @map("name_normalized")
  unitId         String   @map("unit_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  batches ProductBatch[]

  @@unique([companyId, nameNormalized], map: "presentations_company_name_unique")
  @@unique([companyId, id], map: "presentations_company_id_id_key")
  @@index([unitId], map: "presentations_unit_id_idx")
  @@map("presentations")
}

/// `name` no es unico, a proposito: dos productos pueden llamarse igual. La unidad se guarda en
/// `unitId`, fija desde el primer lote, y ya no se deriva del lote mas reciente. `unitId` no lleva
/// `@relation` porque `Unit` es de otro modulo; su FK esta escrita a mano y es drift, igual que su
/// indice. `stock` la mantiene la aplicacion al escribir lotes, nunca un disparador.
/// `companyId` no lleva `@relation` porque `Company` es de otro modulo; su FK esta escrita a mano
/// y es drift, y su indice no es parcial porque el RESTRICT tiene que ver tambien los productos
/// dados de baja. `products_stock_idx` es parcial y vive en la migracion, no aqui: Prisma no
/// modela indices parciales.
/// @module inventario
model Product {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String      @map("name_normalized")
  type           ProductType @default(PRODUCT) @map("type")
  unitId         String?     @map("unit_id") @db.Uuid
  stock          Int         @default(0)
  qtyAlert       Int?        @map("qty_alert")
  imagePath      String?     @map("image_path")
  companyId      String      @map("company_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)

  batches ProductBatch[]

  @@index([companyId], map: "products_company_id_idx")
  @@index([unitId], map: "products_unit_id_idx")
  @@map("products")
}

/// `createdBy`, `updatedBy` y `companyId` no llevan `@relation` porque apuntan a otros modulos; sus
/// FK estan escritas a mano y son drift. NULL en la autoria = no lo creo una persona.
/// `companyId` es columna propia del lote, y no se deriva del producto, porque la unicidad
/// `(company_id, lot)` no puede indexar otra tabla; `product_batches_check_company` exige que
/// coincida con la del producto y la de la presentacion. Los CHECK de `stock`, `unitCost` y `lot`
/// estan escritos a mano. No hay coste total: se calcula al leer.
/// @module inventario
model ProductBatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  presentationId String    @map("presentation_id") @db.Uuid
  stock          Int
  unitCost       Decimal   @map("unit_cost") @db.Decimal(14, 4)
  /// Texto exacto, sin normalizar: la unicidad por empresa distingue mayusculas.
  lot            String    @map("lot")
  /// Sin `@default`: el «hoy» lo pone el caso de uso con su reloj, y que no sea futura solo lo
  /// comprueba la aplicacion.
  purchaseDate   DateTime  @map("purchase_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  companyId      String    @map("company_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  presentation Presentation        @relation(fields: [presentationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movements    InventoryMovement[]

  @@unique([companyId, lot], map: "product_batches_company_lot_unique")
  @@index([companyId], map: "product_batches_company_id_idx")
  @@index([productId], map: "product_batches_product_id_idx")
  @@index([presentationId], map: "product_batches_presentation_id_idx")
  @@index([createdBy], map: "product_batches_created_by_idx")
  @@index([updatedBy], map: "product_batches_updated_by_idx")
  @@map("product_batches")
}

/// Los valores van en minuscula porque asi estan escritos los datos, y el orden de declaracion no
/// se reordena por estetica: Postgres ordena un enum por declaracion y reordenarlo obliga a
/// recrear el tipo.
enum InventoryMovementKind {
  opening
  adjustment
}

/// Un asiento no se corrige: se corrige con otro. Sin `updatedAt` ni `deletedAt`, a proposito.
/// `companyId` y `createdBy` no llevan `@relation`: `Company` y `User` son de otro modulo, sus
/// FK estan escritas a mano y son drift. NULL en `createdBy` = no lo hizo una persona. `batchId`
/// si lleva `@relation`: `ProductBatch` es del mismo modulo. `reason` sigue siendo `TEXT`, con un
/// CHECK que enumera los motivos; el conjunto vive en una constante del dominio.
/// @module inventario
model InventoryMovement {
  id        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId   String                @map("batch_id") @db.Uuid
  kind      InventoryMovementKind
  quantity  Int
  reason    String?
  companyId String                @map("company_id") @db.Uuid
  createdBy String?               @map("created_by") @db.Uuid
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  batch ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([batchId], map: "inventory_movements_batch_id_idx")
  @@index([companyId], map: "inventory_movements_company_id_idx")
  @@index([createdBy], map: "inventory_movements_created_by_idx")
  @@map("inventory_movements")
}

/// `createdBy` y `updatedBy` no llevan `@relation`: un `include` cruzaria a `users` sin que la
/// guardia de modulos lo vea. Sus FK estan escritas a mano. NULL = no la creo una persona.
/// `companyId` tampoco lleva `@relation`, por el mismo motivo pero hacia `companies`: su FK
/// (`recipes_company_id_fkey`) esta escrita a mano en la migracion y es drift a proposito.

/// Enum y no tabla: el conjunto es cerrado a proposito y anadir un valor es una migracion.
enum ProductType {
  PRODUCT
  MACHINE
  PACKAGING
}
/// `recipes_company_name_unique` (empresa, nombre) es PARCIAL por `deleted_at IS NULL` y por
/// eso no se declara `@@unique` aqui: Prisma no modela indices parciales. Ese mismo indice
/// hace de indice de `companyId`, asi que tampoco hay un `@@index([companyId])` propio. Los
/// indices de busqueda siguen siendo parciales o GIN y viven en las migraciones.
/// @module recetas
model Recipe {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  description    String?
  steps          Json      @default("[]")
  imagePath      String?   @map("image_path")
  companyId      String    @map("company_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  lines RecipeLine[]

  @@index([createdBy], map: "recipes_created_by_idx")
  @@index([updatedBy], map: "recipes_updated_by_idx")
  @@map("recipes")
}

/// Sin `deletedAt`: la linea es parte de la receta, y corregir una formula es una edicion normal.
/// `productId` y `unitId` no llevan `@relation` porque apuntan a otros modulos; sus FK estan
/// escritas a mano y son drift. La unidad es anotativa: no hay conversion. Sin `companyId` a
/// proposito: la linea no tiene empresa propia, solo se alcanza a traves de su receta y cae
/// con ella por el `ON DELETE CASCADE` de `recipe_lines_recipe_id_fkey`.
/// @module recetas
model RecipeLine {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 4)
  unitId    String   @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([recipeId, productId], map: "recipe_lines_recipe_id_product_id_key")
  @@index([productId], map: "recipe_lines_product_id_idx")
  @@index([unitId], map: "recipe_lines_unit_id_idx")
  @@map("recipe_lines")
}

/// `createdBy` y `updatedBy` no llevan `@relation`: un `include` cruzaria a `users` sin que la
/// guardia de modulos lo vea. Sus FK estan escritas a mano. `phone` y `email` parecen opcionales
/// pero el CHECK `suppliers_contact_required` exige al menos uno. `companyId` tampoco lleva
/// `@relation`, por el mismo motivo pero hacia `companies`: su FK (`suppliers_company_id_fkey`)
/// esta escrita a mano en la migracion y es drift a proposito. `suppliers_company_name_unique`
/// (empresa, nombre) es PARCIAL por `deleted_at IS NULL` y por eso no se declara `@@unique`
/// aqui: Prisma no modela indices parciales. `suppliers_company_id_id_key` SI se declara -es
/// TOTAL- y es la clave candidata a la que apunta la FK COMPUESTA de `supplier_catalog_lines`
/// hacia el proveedor: quitarla la rompe. Esa misma clave, con `companyId` de cabeza, hace de
/// indice de la columna de empresa, asi que no hay un `@@index([companyId])` propio. Los indices
/// de busqueda siguen siendo parciales o GIN y viven en las migraciones.
/// @module proveedores
model Supplier {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  phone          String?
  email          String?
  companyId      String    @map("company_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  catalogLines SupplierCatalogLine[]

  @@unique([companyId, id], map: "suppliers_company_id_id_key")
  @@index([createdBy], map: "suppliers_created_by_idx")
  @@index([updatedBy], map: "suppliers_updated_by_idx")
  @@map("suppliers")
}

/// No hay vinculo con `products`, a proposito: el catalogo de un proveedor puede incluir cosas que
/// no estan dadas de alta. La identidad `(supplier_id, name_normalized, presentation_id)` sobre las
/// vivas es un indice unico parcial escrito a mano, y no cambia con `companyId`. Las FK a otros
/// modulos van sin `@relation` y son drift. El `Cascade` hacia `suppliers` solo actua en un
/// borrado fisico: la baja del proveedor es logica y marca sus lineas en la misma transaccion.
/// Los CHECK de costo, minimo y plazo, y los indices de busqueda, estan escritos a mano en las
/// migraciones. `companyId` es columna propia de la linea -no se deriva de su proveedor-: es el
/// origen de las dos FK COMPUESTAS escritas a mano, `supplier_catalog_lines_company_id_supplier_id_fkey`
/// (hacia el proveedor) y `supplier_catalog_lines_company_id_presentation_id_fkey` (hacia la
/// presentacion), que hacen imposible que la empresa de la linea contradiga la de cualquiera de
/// las dos. Sin `@@unique` nuevo, a proposito.
/// @module proveedores
model SupplierCatalogLine {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  name           String
  nameNormalized String    @map("name_normalized")
  presentationId String    @map("presentation_id") @db.Uuid
  unitId         String?   @map("unit_id") @db.Uuid
  imagePath      String?   @map("image_path")
  cost           Decimal   @db.Decimal(14, 4)
  minPurchase    Decimal?  @map("min_purchase") @db.Decimal(14, 4)
  deliveryTime   Int?      @map("delivery_time")
  companyId      String    @map("company_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, supplierId], map: "supplier_catalog_lines_company_id_supplier_id_idx")
  @@index([presentationId], map: "supplier_catalog_lines_presentation_id_idx")
  @@index([unitId], map: "supplier_catalog_lines_unit_id_idx")
  @@index([createdBy], map: "supplier_catalog_lines_created_by_idx")
  @@index([updatedBy], map: "supplier_catalog_lines_updated_by_idx")
  @@map("supplier_catalog_lines")
}

/// Sin `deletedAt`: el borrado logico es un UPDATE, que ninguna FK bloquea. Sin `@@unique`, a
/// proposito: la unicidad de nombre y simbolo es por ambito (empresa o sistema) con cuatro indices
/// parciales escritos a mano en `units_equivalence_and_scope`, y un `@@unique` haria que
/// `migrate dev` regenerara un indice global.
/// `companyId` y `baseUnitId` van sin `@relation`: `Company` es de otro modulo y la auto-referencia
/// exigiria un lado inverso que nadie consulta. `factor` y `baseUnitId` van juntos o ninguno por el
/// CHECK `units_derivation_pair_check`.
/// @module unidades
model Unit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  nameNormalized String   @map("name_normalized")
  symbol         String?
  companyId      String?  @map("company_id") @db.Uuid
  baseUnitId     String?  @map("unit_id") @db.Uuid
  factor         Decimal? @db.Decimal(14, 4)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId], map: "units_company_id_idx")
  @@index([baseUnitId], map: "units_unit_id_idx")
  @@map("units")
}

/// Enum y no tabla: el conjunto es cerrado a proposito y anadir un valor es una migracion.
enum OrderStatus {
  PENDIENTE
  EN_CURSO
  ENTREGADO
  /// Va el ultimo: reordenar obligaria a recrear el tipo en vez de anadir un valor.
  CANCELADO
}

/// El orden de declaracion es el de la prioridad, de menor a mayor: Postgres ordena un enum por
/// declaracion, asi que reordenar cambia el `ORDER BY priority`.
enum OrderPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

/// Sin fecha de solicitud: es `createdAt`. El correlativo es un indice unico total, no parcial: un
/// pedido dado de baja conserva su numero, y se mide DENTRO de la empresa: `(empresa, ano,
/// secuencia)`. `orderYear` es el ano de `createdAt` en UTC, y lo exige el CHECK
/// `orders_order_year_matches_created_at`. `recipeId`, `createdBy`, `updatedBy` y `companyId` van
/// sin `@relation` porque apuntan a otros modulos; sus FK y CHECK estan escritos a mano y son drift:
/// hay que borrar a mano su `DROP CONSTRAINT` de toda migracion generada.
/// `orders_id_company_id_key` es la clave candidata a la que apunta la FK COMPUESTA de
/// `order_assignments`: quitarla la rompe.
/// Los indices de listado son parciales y viven en la migracion `list_query_indexes`.
/// @module pedidos
model Order {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderYear          Int           @map("order_year")
  orderSequence      Int           @map("order_sequence")
  recipeId           String        @map("recipe_id") @db.Uuid
  quantity           Decimal       @db.Decimal(14, 4)
  priority           OrderPriority @default(BAJA)
  status             OrderStatus   @default(PENDIENTE)
  /// Sin longitud en la columna: el tope vive en la validacion de entrada. Que exista solo en un
  /// pedido cancelado lo exige el CHECK `orders_cancellation_reason_matches_status`.
  cancellationReason String?       @map("cancellation_reason")
  companyId          String        @map("company_id") @db.Uuid
  createdBy          String?       @map("created_by") @db.Uuid
  updatedBy          String?       @map("updated_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  /// Coste de los ingredientes de la receta del pedido, con los lotes del momento en que se
  /// escribio. NULL = no se pudo calcular; nunca 0.
  ingredientsCost    Decimal?      @map("ingredients_cost") @db.Decimal(14, 4)

  @@unique([companyId, orderYear, orderSequence], map: "orders_company_year_sequence_key")
  @@unique([id, companyId], map: "orders_id_company_id_key")
  @@index([recipeId], map: "orders_recipe_id_idx")
  @@index([createdBy], map: "orders_created_by_idx")
  @@index([updatedBy], map: "orders_updated_by_idx")
  @@map("orders")
}

/// Las tres FK y el CHECK van escritos a mano y sin `@relation`, porque los padres son de otros
/// modulos, y son drift: hay que borrar a mano su `DROP CONSTRAINT` de toda migracion generada. Las
/// TRES FK -pedido, persona y grupo- son compuestas con `company_id`: los tres son de la misma
/// empresa por construccion: la del pedido va contra `orders_id_company_id_key`, asi que una fila
/// con pedido de otra empresa no puede existir.
/// La del grupo es `MATCH SIMPLE` a proposito, porque `MATCH FULL` impediria una
/// asignacion sin grupo. `workGroupName` es una foto del nombre al asignar. Sin `deleted_at`: quitar
/// a alguien borra la fila, y con filas muertas la PK dejaria de ser unica.
/// @module asignaciones
model OrderAssignment {
  orderId       String   @map("order_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  workGroupId   String?  @map("work_group_id") @db.Uuid
  workGroupName String?  @map("work_group_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([orderId, userId], map: "order_assignments_pkey")
  @@index([userId], map: "order_assignments_user_id_idx")
  @@index([workGroupId], map: "order_assignments_work_group_id_idx")
  @@map("order_assignments")
}

enum DocumentStrategy {
  catalogo
  formula
}

enum DocumentFileStatus {
  queued
  processing
  done
  error
}

/// La TANDA: quien sube elige la estrategia UNA vez y sus hasta diez archivos la heredan. Sin
/// `deleted_at`: nada de esta ficha borra estas filas, y una columna que nadie escribe es
/// infraestructura por si acaso.
/// Las FK a `companies` y `users` van escritas a mano en la migracion y son drift: hay que borrar su
/// `DROP CONSTRAINT` de toda migracion generada, como en `orders` y `order_assignments`.
/// `document_batches_id_company_id_key` es la clave candidata a la que apunta la FK COMPUESTA de
/// `document_files`: quitarla la rompe.
/// @module documentos
model DocumentBatch {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  strategy  DocumentStrategy
  createdBy String?          @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, companyId], map: "document_batches_id_company_id_key")
  @@index([companyId], map: "document_batches_company_id_idx")
  @@index([createdBy], map: "document_batches_created_by_idx")
  @@map("document_batches")
}

/// Un PDF de una tanda, con su estado. `extracted_text` guarda lo que escribio la IA TAL CUAL, como
/// texto plano y sin longitud declarada: un catalogo de 40 paginas no cabe en un `varchar`.
/// La FK a la tanda es COMPUESTA con `company_id` contra `document_batches_id_company_id_key`: una
/// fila cuya tanda sea de otra empresa no puede existir.
/// `updated_at` es el reloj de la caducidad: se mueve al reclamar y al terminar.
/// @module documentos
model DocumentFile {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId        String             @map("batch_id") @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  path           String
  status         DocumentFileStatus @default(queued)
  extractedText  String?            @map("extracted_text")
  errorCode      String?            @map("error_code")
  errorReason    String?            @map("error_reason")
  queueMessageId String?            @map("queue_message_id")
  attempts       Int                @default(0)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, path], map: "document_files_company_path_key")
  @@index([batchId], map: "document_files_batch_id_idx")
  @@index([companyId], map: "document_files_company_id_idx")
  @@map("document_files")
}
