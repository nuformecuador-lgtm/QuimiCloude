# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
# Un solo lockfile, el del `packageManager` de package.json (pnpm-lock.yaml).
/package-lock.json
/yarn.lock
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/harnessConfig

# worktrees del arnes (./scripts/wt.sh) — un checkout por feature, ver docs/worktrees.md
/.worktrees/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla SI se versiona: no lleva valores, solo el formato esperado.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reporte json de vitest para comparar contra tests/baseline-rojos.json
.vitest-rojos.json
# codigo de salida de vitest de un shard de CI (`GATE_SHARD=i/N ./init.sh --completo`)
.vitest-codigo

# playwright (E2E): reportes, artefactos de las corridas y cache local
/test-results/
/playwright-report/
/.playwright/

# rastros de las bases efimeras de los tests de integracion (QC-77, tests/helpers/test-database.ts)
/.qc-test-db/

# Borradores de prompts de IA (QC-131/QC-157). R9 de QC-129: ningun archivo versionado contiene el texto de un prompt.
/borradores-de-prompts/

# Arnés v2 — estado que no se versiona (diseño v2 §4)
# Logs de corridas (gate, E2E, suites): se generan en cada máquina y no se leen enteros.
/progress/logs/
# Sesión personal del humano/agente: dónde lo dejó cada uno; plantilla en progress/sesion.local.example.md.
/progress/sesion.local.md
# Configuración local del arnés (overrides por máquina sobre arnes.config.json).
/.arnes.local.json
# Copia del board de Jira: se regenera con F0 y se consulta con node/jq, nunca la fuente de verdad.
/feature_list.json
