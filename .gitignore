# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/harnessConfig

# worktrees del arnes (./scripts/wt.sh) — un checkout por feature, ver docs/worktrees.md
/.worktrees/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla SI se versiona: no lleva valores, solo el formato esperado.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reporte json de vitest para comparar contra tests/baseline-rojos.json
.vitest-rojos.json

# playwright (E2E): reportes, artefactos de las corridas y cache local
/test-results/
/playwright-report/
/.playwright/
