exports[`paridad de clientes > R1 R2 R17 — error de catalogo, con el reintento por enlace a la misma consulta 1`] = `
"
div role=generic
  div role=generic class="flex flex-1 flex-col gap-4 md:p-6 p-4"
    div role=generic class="flex flex-wrap gap-2 items-center justify-between"
      h1 role=heading name="Clientes" data-testid="clientes-title" class="font-semibold text-2xl"
        "Clientes"
    div role=alert data-testid="customer-list-error" class="border border-destructive/40 flex flex-col gap-3 items-start p-4 rounded-lg"
      p role=paragraph class="font-medium text-sm"
        "No se pudo cargar la lista de clientes."
      p role=paragraph data-testid="customer-list-error-message" class="text-muted-foreground text-sm"
        "El actor no tiene permiso para realizar esta operacion."
      p role=paragraph data-testid="customer-list-error-code" class="text-muted-foreground text-xs"
        "unauthorized"
      a role=link name="Reintentar" data-testid="customer-list-retry" href="/clientes?page=2&pageSize=10&q=ana" class="[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0 active:not-aria-[haspopup]:scale-[0.98] aria-expanded:bg-muted aria-expanded:text-foreground aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 bg-background bg-clip-padding border border-border btn-veil cursor-pointer dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 dark:bg-input/30 dark:border-input disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring focus-visible:outline-solid font-medium gap-1.5 group/button h-8 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 inline-flex items-center justify-center min-h-11 min-w-11 outline-none px-2.5 rounded-lg select-none shrink-0 text-sm transition-all whitespace-nowrap"
        "Reintentar"
"
`;

