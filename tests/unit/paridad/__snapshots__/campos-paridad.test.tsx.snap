exports[`paridad de campos — fecha > R1 R16 R19 — F1 fecha de compra: cerrada, con «hoy» y su input oculto 1`] = `
"
div role=generic class="flex flex-col gap-2"
  span role=generic class="font-medium text-sm"
    "Fecha de compra"
  input data-testid="product-batch-date-value" type="hidden"
  button role=button name="Fecha de compra" aria-expanded="false" aria-haspopup="dialog" aria-labelledby="<id>" data-testid="product-field-purchaseDate" type="button" class="bg-background border border-input gap-1.5 hover:bg-muted inline-flex items-center min-h-11 min-w-11 px-2.5 rounded-lg text-sm"
    svg aria-hidden="true" height="24" width="24" class="lucide lucide-calendar size-4"
    "2026-10-09"
controles:
input name="purchaseDate" type="hidden" value="2026-10-09"
"
`;

