          "Subir PDFs"
    div role=alert data-testid="recipe-list-error" class="border border-destructive/40 flex flex-col gap-3 items-start p-4 rounded-lg"
      p role=paragraph class="font-medium text-sm"
        "No se pudo cargar el catálogo."
      p role=paragraph data-testid="recipe-list-error-message" class="text-muted-foreground text-sm"
        "El actor no tiene permiso para realizar esta operacion."
      p role=paragraph data-testid="recipe-list-error-code" class="text-muted-foreground text-xs"
        "unauthorized"
      button role=button name="Reintentar" data-testid="recipe-list-retry" type="button" class="[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0 active:not-aria-[haspopup]:translate-y-px aria-expanded:bg-muted aria-expanded:text-foreground aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 bg-background bg-clip-padding border border-border cursor-pointer dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 dark:bg-input/30 dark:border-input dark:hover:bg-input/50 disabled:opacity-50 disabled:pointer-events-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 font-medium gap-1.5 group/button h-8 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 hover:bg-muted hover:text-foreground inline-flex items-center justify-center min-h-11 min-w-11 outline-none px-2.5 rounded-lg select-none shrink-0 text-sm transition-all whitespace-nowrap"
        "Reintentar"
