exports[`paridad de formulas — lista > R1 R2 R17 — error de catalogo, y «Reintentar» vuelve a pedir la pagina 1`] = `
"
div role=generic
  div role=generic class="flex flex-1 flex-col gap-4 md:p-6 p-4"
