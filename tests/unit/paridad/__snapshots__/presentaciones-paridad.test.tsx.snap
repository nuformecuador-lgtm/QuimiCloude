exports[`paridad de presentaciones > R1 R2 R17 — error de catalogo, y «Reintentar» hace lo de hoy 1`] = `
"
div role=generic
  div role=generic class="flex flex-1 flex-col gap-4 md:p-6 p-4"
    div role=generic class="flex flex-wrap gap-2 items-center justify-between"
      h1 role=heading name="Presentaciones" data-testid="presentaciones-title" class="font-semibold text-2xl"
        "Presentaciones"
      button role=button name="Nueva presentación" aria-expanded="false" aria-haspopup="dialog" data-testid="presentation-create-open" type="button" class="[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0 active:not-aria-[haspopup]:scale-[0.98] aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 bg-clip-padding bg-primary border border-transparent btn-shine cursor-pointer dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 disabled:opacity-50 disabled:pointer-events-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 font-medium gap-1.5 group/button h-8 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 inline-flex items-center justify-center min-h-11 min-w-11 outline-none px-2.5 rounded-lg select-none shrink-0 text-primary-foreground text-sm transition-all whitespace-nowrap"
        svg aria-hidden="true" height="24" width="24" class="lucide lucide-plus"
        "Nueva presentación"
    div role=alert data-testid="presentation-list-error" class="border border-destructive/40 flex flex-col gap-3 items-start p-4 rounded-lg"
      p role=paragraph class="font-medium text-sm"
        "No se pudo cargar la lista de presentaciones."
      p role=paragraph data-testid="presentation-list-error-message" class="text-muted-foreground text-sm"
        "El actor no tiene permiso para realizar esta operacion."
      p role=paragraph data-testid="presentation-list-error-code" class="text-muted-foreground text-xs"
        "unauthorized"
      button role=button name="Reintentar" data-testid="presentation-list-retry" type="button" class="[&_svg:not([class*='size-'])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0 active:not-aria-[haspopup]:scale-[0.98] aria-expanded:bg-muted aria-expanded:text-foreground aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 bg-background bg-clip-padding border border-border btn-veil cursor-pointer dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 dark:bg-input/30 dark:border-input disabled:opacity-50 disabled:pointer-events-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 font-medium gap-1.5 group/button h-8 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2 inline-flex items-center justify-center min-h-11 min-w-11 outline-none px-2.5 rounded-lg select-none shrink-0 text-sm transition-all whitespace-nowrap"
        "Reintentar"
"
`;

