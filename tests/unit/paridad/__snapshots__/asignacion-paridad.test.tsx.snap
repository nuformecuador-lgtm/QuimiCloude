exports[`paridad de asignacion — filas y vacio de las listas que se tocan > R1 — mis asignados, con filas 1`] = `
"
div role=generic
  div role=generic aria-busy="false" data-testid="assigned-orders-table" class="transition-opacity"
    div role=generic data-testid="data-table" class="flex flex-col gap-4"
      div role=generic data-testid="data-table-filters" class="flex flex-col gap-3"
        div role=generic class="flex flex-wrap gap-3 items-center"
      div role=generic class="relative"
        div role=generic class="overflow-x-auto relative w-full"
          table role=table class="caption-bottom text-sm w-full"
            thead role=rowgroup class="[&_tr]:border-b"
              tr role=row name="Nº de pedido Receta Cantidad Presentación Prioridad Estado Responsables Entrar" class="border-b data-[state=selected]:bg-muted has-aria-expanded:bg-muted/50 hover:bg-muted/50 transition-colors"
                th role=columnheader name="Nº de pedido" data-testid="data-table-head-orderNumber" style="position: sticky; left: 0px; z-index: 1;" class="[&:has([role=checkbox])]:pr-0 align-middle bg-background font-medium h-10 overflow-hidden px-2 relative text-ellipsis text-foreground text-left whitespace-nowrap"
                  div role=generic class="flex gap-2 items-center min-w-0"
                    span role=generic
                      "Nº de pedido"
